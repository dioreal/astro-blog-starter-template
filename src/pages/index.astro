---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
<head>
	<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />

	<!-- FAVICON -->
	<link
		rel="icon"
		type="image/webp"
		href="/dio-re-al-white-sun-of-dio-re-al-x-design.webp"
	/>

	<link
		rel="apple-touch-icon"
		href="/dio-re-al-white-sun-of-dio-re-al-x-design.webp"
	/>

	<meta name="theme-color" content="#080000" />

	<style>
		:root {
			--black: #050505;
			--deep-black: #090000;
			--blood: #8b0000;
			--blood-bright: #c11212;
			--crimson: #ff2020;
			--white: #f5f5f5;
			--silver: #c9c9c9;
			--dark-red: #260000;
		}

		* {
			box-sizing: border-box;
		}

		html {
			scroll-behavior: smooth;
			background: var(--black);
		}

		body {
			margin: 0;
			background:
				radial-gradient(
					circle at 50% 20%,
					rgba(139, 0, 0, 0.18),
					transparent 38%
				),
				linear-gradient(
					180deg,
					#050000 0%,
					#100000 45%,
					#030303 100%
				);
			color: var(--white);
			font-family: Georgia, "Times New Roman", serif;
			overflow-x: hidden;
		}

		a {
			color: var(--white);
			text-decoration: none;
		}

		a:hover {
			color: var(--crimson);
		}

		/* =========================================
		   ANIMATED SUN
		   ========================================= */

		.sun-background {
			position: fixed;
			width: min(75vw, 850px);
			height: min(75vw, 850px);
			left: 50%;
			top: 48%;
			transform: translate(-50%, -50%);
			z-index: 0;
			pointer-events: none;
			opacity: 0.075;
			animation: sunFloat 18s ease-in-out infinite;
		}

		.sun-background img {
			width: 100%;
			height: 100%;
			object-fit: contain;
			animation: sunRotate 90s linear infinite;
			filter:
				drop-shadow(0 0 20px rgba(255,255,255,.3))
				drop-shadow(0 0 80px rgba(180,0,0,.35));
		}

		@keyframes sunRotate {
			from {
				transform: rotate(0deg);
			}
			to {
				transform: rotate(360deg);
			}
		}

		@keyframes sunFloat {
			0%, 100% {
				transform: translate(-50%, -50%) scale(1);
			}
			50% {
				transform: translate(-50%, -51%) scale(1.035);
			}
		}

		/* =========================================
		   CONTENT
		   ========================================= */

		.site {
			position: relative;
			z-index: 1;
		}

		/* =========================================
		   NAVIGATION
		   ========================================= */

		.navbar {
			position: sticky;
			top: 0;
			z-index: 100;
			display: flex;
			justify-content: center;
			align-items: center;
			gap: 30px;
			padding: 18px 25px;
			background: rgba(5, 0, 0, 0.88);
			border-bottom: 1px solid rgba(255,255,255,.12);
			backdrop-filter: blur(12px);
		}

		.navbar a {
			font-family: Arial, sans-serif;
			font-size: 12px;
			font-weight: bold;
			letter-spacing: 2px;
			text-transform: uppercase;
			transition: .3s;
		}

		.navbar a:hover {
			color: var(--crimson);
			text-shadow: 0 0 12px rgba(255,0,0,.7);
		}

		/* =========================================
		   HERO
		   ========================================= */

		.hero {
			min-height: calc(100vh - 60px);
			display: flex;
			flex-direction: column;
			align-items: center;
			justify-content: center;
			text-align: center;
			padding: 100px 25px;
			position: relative;
		}

		.hero-symbol {
			width: 105px;
			height: 105px;
			object-fit: contain;
			margin-bottom: 30px;
			filter:
				drop-shadow(0 0 12px rgba(255,255,255,.55))
				drop-shadow(0 0 35px rgba(180,0,0,.6));
			animation: symbolPulse 5s ease-in-out infinite;
		}

		@keyframes symbolPulse {
			0%, 100% {
				transform: scale(1);
				filter:
					drop-shadow(0 0 12px rgba(255,255,255,.55))
					drop-shadow(0 0 35px rgba(180,0,0,.6));
			}
			50% {
				transform: scale(1.06);
				filter:
					drop-shadow(0 0 20px rgba(255,255,255,.8))
					drop-shadow(0 0 55px rgba(255,0,0,.65));
			}
		}

		.eyebrow {
			font-family: Arial, sans-serif;
			font-size: 12px;
			font-weight: bold;
			letter-spacing: 6px;
			text-transform: uppercase;
			color: var(--silver);
			margin-bottom: 25px;
		}

		.hero h1 {
			max-width: 1200px;
			margin: 0;
			font-family: Georgia, "Times New Roman", serif;
			font-size: clamp(45px, 8vw, 105px);
			line-height: .95;
			font-weight: normal;
			letter-spacing: -3px;
			text-transform: uppercase;
			color: #fff;
			text-shadow:
				0 0 15px rgba(255,255,255,.15),
				0 0 45px rgba(150,0,0,.35);
		}

		.hero h1 span {
			display: block;
			color: var(--blood-bright);
			font-size: .52em;
			letter-spacing: 8px;
			margin-top: 20px;
			text-shadow: 0 0 25px rgba(255,0,0,.35);
		}

		.hero-line {
			width: 180px;
			height: 1px;
			background: linear-gradient(
				90deg,
				transparent,
				#fff,
				var(--blood-bright),
				#fff,
				transparent
			);
			margin: 35px auto;
		}

		.hero-description {
			max-width: 720px;
			font-size: 19px;
			line-height: 1.8;
			color: #d2d2d2;
		}

		.hero-description strong {
			color: #fff;
		}

		/* =========================================
		   INTRODUCTION
		   ========================================= */

		.introduction {
			max-width: 1000px;
			margin: 0 auto;
			padding: 120px 25px;
			text-align: center;
		}

		.introduction h2 {
			font-size: clamp(30px, 5vw, 55px);
			font-weight: normal;
			margin-bottom: 35px;
			text-transform: uppercase;
			letter-spacing: 3px;
		}

		.introduction h2::after {
			content: "";
			display: block;
			width: 90px;
			height: 2px;
			background: var(--blood-bright);
			margin: 25px auto;
		}

		.quote {
			border-left: 2px solid var(--blood-bright);
			border-right: 2px solid var(--blood-bright);
			padding: 35px 45px;
			margin: 45px auto;
			font-size: clamp(20px, 3vw, 30px);
			font-style: italic;
			line-height: 1.6;
			background: rgba(100,0,0,.08);
		}

		.quote-author {
			display: block;
			margin-top: 20px;
			font-family: Arial, sans-serif;
			font-size: 12px;
			font-style: normal;
			letter-spacing: 3px;
			color: var(--silver);
			text-transform: uppercase;
		}

		/* =========================================
		   CARDS
		   ========================================= */

		.section {
			max-width: 1150px;
			margin: auto;
			padding: 90px 25px;
		}

		.section-title {
			text-align: center;
			margin-bottom: 55px;
		}

		.section-title h2 {
			font-size: 38px;
			font-weight: normal;
			letter-spacing: 4px;
			text-transform: uppercase;
			margin: 0 0 15px;
		}

		.section-title p {
			color: #999;
			font-family: Arial, sans-serif;
			font-size: 13px;
			letter-spacing: 2px;
		}

		.cards {
			display: grid;
			grid-template-columns: repeat(3, 1fr);
			gap: 20px;
		}

		.card {
			padding: 35px 28px;
			border: 1px solid rgba(255,255,255,.12);
			background: rgba(10,0,0,.7);
			transition: .4s;
		}

		.card:hover {
			border-color: var(--blood-bright);
			transform: translateY(-5px);
			box-shadow: 0 15px 50px rgba(120,0,0,.18);
		}

		.card h3 {
			color: #fff;
			font-size: 20px;
			font-weight: normal;
			text-transform: uppercase;
			letter-spacing: 2px;
		}

		.card p {
			color: #aaa;
			line-height: 1.7;
			font-size: 15px;
		}

		/* =========================================
		   LINKS
		   ========================================= */

		.links {
			display: flex;
			flex-wrap: wrap;
			justify-content: center;
			gap: 12px;
			margin-top: 35px;
		}

		.links a {
			border: 1px solid rgba(255,255,255,.25);
			padding: 14px 22px;
			font-family: Arial, sans-serif;
			font-size: 11px;
			font-weight: bold;
			letter-spacing: 2px;
			text-transform: uppercase;
			transition: .3s;
		}

		.links a:hover {
			background: var(--blood);
			border-color: var(--blood-bright);
			color: #fff;
		}

		.donate {
			border-color: var(--blood-bright) !important;
			color: #fff;
		}

		/* =========================================
		   FOOTER
		   ========================================= */

		footer {
			border-top: 1px solid rgba(255,255,255,.12);
			text-align: center;
			padding: 60px 25px;
			background: rgba(0,0,0,.5);
		}

		.footer-symbol {
			width: 55px;
			height: 55px;
			object-fit: contain;
			margin-bottom: 20px;
			opacity: .85;
		}

		footer h3 {
			font-size: 20px;
			font-weight: normal;
			letter-spacing: 3px;
			text-transform: uppercase;
		}

		.copyright {
			margin-top: 30px;
			color: #777;
			font-family: Arial, sans-serif;
			font-size: 11px;
			letter-spacing: 1px;
		}

		/* =========================================
		   MOBILE
		   ========================================= */

		@media (max-width: 800px) {

			.navbar {
				gap: 12px;
				flex-wrap: wrap;
				padding: 15px;
			}

			.navbar a {
				font-size: 9px;
				letter-spacing: 1px;
			}

			.hero {
				min-height: 90vh;
				padding: 80px 20px;
			}

			.hero h1 {
				letter-spacing: -1px;
			}

			.hero h1 span {
				letter-spacing: 4px;
			}

			.hero-description {
				font-size: 16px;
			}

			.cards {
				grid-template-columns: 1fr;
			}

			.quote {
				padding: 25px 20px;
			}

			.sun-background {
				width: 120vw;
				height: 120vw;
				opacity: .055;
			}
		}

		@media (prefers-reduced-motion: reduce) {
			.sun-background,
			.sun-background img,
			.hero-symbol {
				animation: none;
			}
		}
	</style>
</head>

<body>

	<!-- =========================================
	     BACKGROUND SUN
	     ========================================= -->

	<div class="sun-background" aria-hidden="true">
		<img
			src="/dio-re-al-white-sun-of-dio-re-al-x-design.webp"
			alt=""
		/>
	</div>

	<div class="site">

		<!-- =====================================
		     NAVIGATION
		     ===================================== -->

		<nav class="navbar">
			<a href="/">Home</a>
			<a href="#introduction">Dio Re Al</a>
			<a href="#alipseism">Alipseism</a>
			<a href="#kingdom">Kingdom</a>
			<a href="#works">Works</a>
			<a href="#contact">Contact</a>
		</nav>


		<!-- =====================================
		     HERO
		     ===================================== -->

		<header class="hero">

			<img
				class="hero-symbol"
				src="/dio-re-al-white-sun-of-dio-re-al-x-design.webp"
				alt="Sun of Dio Re Al"
			/>

			<div class="eyebrow">
				The Official Domain
			</div>

			<h1>
				Divine Kingdom
				<span>of Dio Re Al</span>
			</h1>

			<div class="hero-line"></div>

			<p class="hero-description">
				The official website of the <strong>Divine Kingdom of Dio Re Al</strong>,
				its teachings, works, writings, art, philosophy, lifestyle, and
				the world of Alipseism / Diorealism.
			</p>

			<div class="links">
				<a href="#introduction">Enter the Kingdom</a>
				<a href="https://allmylinks.com/divinoreinodedioreal" target="_blank">
					All My Links
				</a>
			</div>

		</header>


		<!-- =====================================
		     INTRODUCTION
		     ===================================== -->

		<section class="introduction" id="introduction">

			<h2>Dio Re Al</h2>

			<p>
				<strong>I am Lord Al, Dio Re Al...</strong>
				The Only Real Eternal Invictus Immortal God King of All.
			</p>

			<div class="quote">
				“Selflessness does not exist. You can't be selfless without a self
				in the first place.”
				<span class="quote-author">
					— Dio Re Al
				</span>
			</div>

			<p>
				Alipseism, also known as Diorealism, is a religion, philosophy,
				and lifestyle created and led by Dio Re Al.
			</p>

		</section>


		<!-- =====================================
		     ALIPSEISM
		     ===================================== -->

		<section class="section" id="alipseism">

			<div class="section-title">
				<h2>Alipseism</h2>
				<p>Religion • Philosophy • Lifestyle</p>
			</div>

			<div class="cards">

				<article class="card">
					<h3>The Self</h3>
					<p>
						The individual self is placed at the center of existence,
						self-knowledge, self-love, creation, and personal sovereignty.
					</p>
				</article>

				<article class="card">
					<h3>The Eternal</h3>
					<p>
						The pursuit of permanence, transcendence, creation, and the
						overcoming of limitation are central themes.
					</p>
				</article>

				<article class="card">
					<h3>The Kingdom</h3>
					<p>
						The Divine Kingdom represents the complete body of works,
						teachings, symbols, writings, art, and creations surrounding
						Dio Re Al.
					</p>
				</article>

			</div>

		</section>


		<!-- =====================================
		     KINGDOM
		     ===================================== -->

		<section class="section" id="kingdom">

			<div class="section-title">
				<h2>The Divine Kingdom</h2>
				<p>Official realms and works</p>
			</div>

			<div class="cards">

				<article class="card">
					<h3>Doctrine</h3>
					<p>
						Explore the principles, foundations, ideas, and writings
						of Alipseism / Diorealism.
					</p>
				</article>

				<article class="card">
					<h3>Lore</h3>
					<p>
						Discover the continuing lore, symbols, characters,
						kingdoms, concepts, and creative universe of Dio Re Al.
					</p>
				</article>

				<article class="card">
					<h3>Creative Works</h3>
					<p>
						Art, poetry, music, writing, digital creations, and
						other works belonging to the Divine Kingdom.
					</p>
				</article>

			</div>

		</section>


		<!-- =====================================
		     WORKS
		     ===================================== -->

		<section class="section" id="works">

			<div class="section-title">
				<h2>Official Works & Presence</h2>
				<p>Explore the Kingdom beyond this domain</p>
			</div>

			<div class="links">

				<a
					href="https://allmylinks.com/divinoreinodedioreal"
					target="_blank"
				>
					All My Links
				</a>

				<a
					href="https://www.poeticous.com/alczolivier"
					target="_blank"
				>
					Poetry
				</a>

				<a
					href="https://www.artstation.com/diosreyal"
					target="_blank"
				>
					ArtStation
				</a>

				<a
					href="https://www.twitch.tv/diosreyal"
					target="_blank"
				>
					Twitch
				</a>

				<a
					class="donate"
					href="https://www.paypal.com/donate/?cmd=_donations&source=url&business=kingdom_of_al@outlook.es"
					target="_blank"
				>
					Support the Cause
				</a>

			</div>

		</section>


		<!-- =====================================
		     CONTACT
		     ===================================== -->

		<section class="section" id="contact">

			<div class="section-title">
				<h2>Contact</h2>
				<p>Official correspondence</p>
			</div>

			<div style="text-align:center;">

				<p>
					For official correspondence:
				</p>

				<p>
					<a
						href="mailto:divinekingdomofal@proton.me"
						style="font-size:20px;"
					>
						divinekingdomofal@proton.me
					</a>
				</p>

			</div>

		</section>


		<!-- =====================================
		     FOOTER
		     ===================================== -->

		<footer>

			<img
				class="footer-symbol"
				src="/dio-re-al-white-sun-of-dio-re-al-x-design.webp"
				alt="Sun of Dio Re Al"
			/>

			<h3>
				Divine Kingdom of Dio Re Al
			</h3>

			<p>
				The Official Domain of Dio Re Al
			</p>

			<div class="links">

				<a href="/">Home</a>

				<a
					href="mailto:divinekingdomofal@proton.me"
				>
					Email
				</a>

				<a
					href="https://allmylinks.com/divinoreinodedioreal"
					target="_blank"
				>
					All My Links
				</a>

			</div>

			<div class="copyright">
				© The Divine Kingdom of Dio Re Al • All Rights Reserved.
			</div>

		</footer>

	</div>

</body>
</html>
