
---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>

	<body>
		<Header />

		<main>

			<!-- HERO -->

			<section class="hero">
				<div class="blood-moon"></div>
				<div class="solar-crown">☉</div>

				<div class="hero-content">

					<p class="overline">
						THE OFFICIAL WEBSITE OF
					</p>

					<h1>
						DIVINE KINGDOM
					</h1>

					<h2>
						OF DIO RE AL
					</h2>

					<div class="blood-line"></div>

					<p class="hero-description">
						The religion, philosophy, lifestyle and sovereign
						kingdom of Dio Re Al.
					</p>

					<div class="hero-buttons">
						<a href="#faith" class="button-white">
							ENTER THE KINGDOM
						</a>

						<a href="#teachings" class="button-dark">
							DISCOVER ALIPSEISM
						</a>
					</div>

				</div>
			</section>


			<!-- INTRODUCTION -->

			<section class="introduction">

				<div class="intro-symbol">
					☉
				</div>

				<div class="intro-content">

					<p class="overline">
						THE KING
					</p>

					<h2>
						I AM LORD AL
					</h2>

					<div class="blood-line"></div>

					<p class="royal-introduction">
						I am Lord Al, Dio Re Al... The Only Real Eternal
						Invictus Immortal God King of All.
					</p>

					<p>
						Alipseism, also known as Diorealism, is my
						religion, philosophy and lifestyle. I am its
						Leader, Creator, King, God, Founder and Owner.
					</p>

					<p>
						The Divine Kingdom of Dio Re Al exists as the
						expression of this faith, its teachings, its
						principles, its works and its living tradition.
					</p>

				</div>

			</section>


			<!-- QUOTE -->

			<section class="quote-section">

				<div class="quote-mark">“</div>

				<blockquote>
					Selflessness does not exist. You can't be selfless
					without a self in the first place.
				</blockquote>

				<p>
					— Dio Re Al
				</p>

			</section>


			<!-- FAITH -->

			<section id="faith" class="section">

				<div class="section-heading">

					<p class="overline">
						THE FAITH
					</p>

					<h2>
						ALIPSEISM
					</h2>

					<div class="blood-line"></div>

					<p>
						Religion • Philosophy • Lifestyle
					</p>

				</div>

				<div class="three-columns">

					<article class="doctrine-card">

						<div class="card-number">
							I
						</div>

						<h3>
							SELF-DIVINITY
						</h3>

						<p>
							The individual self is placed at the center
							of existence, identity, creation and value.
						</p>

						<a href="/alipseism/">
							THE TEACHINGS →
						</a>

					</article>


					<article class="doctrine-card">

						<div class="card-number">
							II
						</div>

						<h3>
							FREEDOM
						</h3>

						<p>
							The pursuit of individual sovereignty,
							self-expression, creation and personal
							liberty.
						</p>

						<a href="/alipseism/">
							THE PRINCIPLES →
						</a>

					</article>


					<article class="doctrine-card">

						<div class="card-number">
							III
						</div>

						<h3>
							ETERNITY
						</h3>

						<p>
							The pursuit of permanence, transcendence,
							creation and the overcoming of mortality.
						</p>

						<a href="/alipseism/">
							THE DOCTRINE →
						</a>

					</article>

				</div>

			</section>


			<!-- KINGDOM -->

			<section class="kingdom-section">

				<div class="kingdom-content">

					<p class="overline">
						THE REALM
					</p>

					<h2>
						THE DIVINE KINGDOM
					</h2>

					<div class="blood-line"></div>

					<p>
						The Divine Kingdom of Dio Re Al encompasses
						the faith, works, symbols, realms, beings,
						teachings and lore belonging to the Kingdom.
					</p>

					<p>
						Explore the structure of the Kingdom and its
						developing body of sacred and philosophical
						works.
					</p>

					<a href="/kingdom/" class="button-white">
						EXPLORE THE KINGDOM
					</a>

				</div>

			</section>


			<!-- LORE -->

			<section id="teachings" class="section">

				<div class="section-heading">

					<p class="overline">
						THE RECORD
					</p>

					<h2>
						LORE & WORKS
					</h2>

					<div class="blood-line"></div>

				</div>


				<div class="four-columns">

					<a href="/lore/" class="feature-card">

						<span>01</span>

						<h3>
							LORE
						</h3>

						<p>
							The recorded history, cosmology, events,
							figures and traditions of the Kingdom.
						</p>

						<strong>
							READ →
						</strong>

					</a>


					<a href="/pantheon/" class="feature-card">

						<span>02</span>

						<h3>
							PANTHEON
						</h3>

						<p>
							The divine beings and members of the
							Kingdom's sacred order.
						</p>

						<strong>
							ENTER →
						</strong>

					</a>


					<a href="/art/" class="feature-card">

						<span>03</span>

						<h3>
							ART
						</h3>

						<p>
							Visual works and artistic creations
							of the Divine Kingdom.
						</p>

						<strong>
							VIEW →
						</strong>

					</a>


					<a href="/music/" class="feature-card">

						<span>04</span>

						<h3>
							MUSIC
						</h3>

						<p>
							Music and sound created as part of the
							Kingdom's artistic expression.
						</p>

						<strong>
							LISTEN →
						</strong>

					</a>

				</div>

			</section>


			<!-- OFFICIAL LINKS -->

			<section class="links-section">

				<div class="section-heading">

					<p class="overline">
						OFFICIAL PRESENCE
					</p>

					<h2>
						FOLLOW THE KINGDOM
					</h2>

					<div class="blood-line"></div>

				</div>


				<div class="official-links">

					<a
						href="https://allmylinks.com/divinoreinodedioreal"
						target="_blank"
						rel="noopener noreferrer"
					>
						<span>01</span>
						ALL MY LINKS
						<strong>→</strong>
					</a>


					<a
						href="https://www.poeticous.com/alczolivier"
						target="_blank"
						rel="noopener noreferrer"
					>
						<span>02</span>
						POETICOUS
						<strong>→</strong>
					</a>


					<a
						href="https://www.artstation.com/diosreyal"
						target="_blank"
						rel="noopener noreferrer"
					>
						<span>03</span>
						ARTSTATION
						<strong>→</strong>
					</a>


					<a
						href="https://www.twitch.tv/diosreyal"
						target="_blank"
						rel="noopener noreferrer"
					>
						<span>04</span>
						TWITCH
						<strong>→</strong>
					</a>

				</div>

			</section>


			<!-- SUPPORT -->

			<section class="support-section">

				<div class="support-content">

					<p class="overline">
						SUPPORT THE KINGDOM
					</p>

					<h2>
						SUPPORT THE CAUSE
					</h2>

					<div class="blood-line"></div>

					<p>
						Those who wish to support the development of
						the Divine Kingdom and its works may contribute
						directly to the cause.
					</p>

					<a
						href="https://www.paypal.com/donate/?cmd=_donations&source=url&business=kingdom_of_al@outlook.es"
						target="_blank"
						rel="noopener noreferrer"
						class="donate-button"
					>
						DONATE TO THE KINGDOM
					</a>

				</div>

			</section>


			<!-- CONTACT -->

			<section class="contact-section">

				<div class="contact-content">

					<p class="overline">
						CORRESPONDENCE
					</p>

					<h2>
						CONTACT THE KINGDOM
					</h2>

					<div class="blood-line"></div>

					<p>
						For official correspondence and inquiries:
					</p>

					<a
						href="mailto:divinekingdomofal@proton.me"
						class="email"
					>
						divinekingdomofal@proton.me
					</a>

				</div>

			</section>


			<!-- FINAL -->

			<section class="final-section">

				<div class="final-symbol">
					☉
				</div>

				<p class="overline">
					DIVINE KINGDOM OF DIO RE AL
				</p>

				<h2>
					ALWAYS BE YOURSELF.
				</h2>

				<p class="final-line">
					ETERNAL • INVICTUS • IMMORTAL
				</p>

			</section>

		</main>

		<Footer />

	</body>
</html>


<style>

	:global(html) {
		scroll-behavior: smooth;
	}

	:global(body) {
		margin: 0;
		background: #030303;
		color: #f5f5f5;
		font-family: Georgia, 'Times New Roman', serif;
	}

	:global(a) {
		color: inherit;
	}

	main {
		overflow: hidden;
		background:
			radial-gradient(
				circle at 50% 0%,
				rgba(110, 0, 0, 0.25),
				transparent 35%
			),
			#030303;
	}


	/* HERO */

	.hero {
		min-height: 94vh;
		display: flex;
		align-items: center;
		justify-content: center;
		position: relative;
		text-align: center;
		padding: 70px 24px;
		box-sizing: border-box;
		border-bottom: 1px solid #260606;
		background:
			linear-gradient(
				rgba(0, 0, 0, 0.15),
				rgba(30, 0, 0, 0.35)
			);
	}

	.hero-content {
		position: relative;
		z-index: 2;
		max-width: 1050px;
	}

	.blood-moon {
		position: absolute;
		width: 550px;
		height: 550px;
		border-radius: 50%;
		background:
			radial-gradient(
				circle,
				rgba(170, 0, 0, 0.30),
				rgba(90, 0, 0, 0.12) 42%,
				transparent 70%
			);
		filter: blur(20px);
		animation: bloodPulse 7s ease-in-out infinite;
	}

	.solar-crown {
		position: absolute;
		font-size: 24rem;
		color: rgba(255, 255, 255, 0.025);
		line-height: 1;
		user-select: none;
	}


	.overline {
		color: #d10000;
		font-size: 0.7rem;
		letter-spacing: 0.42em;
		text-transform: uppercase;
		margin-bottom: 25px;
	}

	.hero h1 {
		margin: 0;
		font-size: clamp(3.5rem, 10vw, 8.5rem);
		line-height: 0.9;
		font-weight: 400;
		letter-spacing: 0.08em;
		color: #ffffff;
		text-shadow:
			0 0 20px rgba(255, 255, 255, 0.1),
			0 0 60px rgba(160, 0, 0, 0.25);
	}

	.hero h2 {
		margin: 25px 0 30px;
		font-size: clamp(1.2rem, 3vw, 2rem);
		font-weight: 400;
		letter-spacing: 0.5em;
		color: #d9d9d9;
	}

	.hero-description {
		max-width: 650px;
		margin: 30px auto 40px;
		font-size: 1.1rem;
		line-height: 1.8;
		color: #b9b0b0;
	}

	.blood-line {
		width: 110px;
		height: 1px;
		margin: 25px auto;
		background:
			linear-gradient(
				to right,
				transparent,
				#c90000,
				transparent
			);
	}

	.hero-buttons {
		display: flex;
		justify-content: center;
		gap: 14px;
		flex-wrap: wrap;
	}


	/* BUTTONS */

	.button-white,
	.button-dark,
	.donate-button {
		display: inline-block;
		padding: 15px 27px;
		text-decoration: none;
		font-size: 0.72rem;
		letter-spacing: 0.16em;
		transition: all 0.3s ease;
	}

	.button-white {
		background: #ffffff;
		color: #050000;
	}

	.button-white:hover {
		background: #c90000;
		color: #ffffff;
		box-shadow: 0 0 35px rgba(200, 0, 0, 0.4);
		transform: translateY(-3px);
	}

	.button-dark {
		border: 1px solid #681313;
		background: rgba(20, 0, 0, 0.35);
		color: #ffffff;
	}

	.button-dark:hover {
		border-color: #e00000;
		color: #ff3333;
	}


	/* INTRODUCTION */

	.introduction {
		max-width: 900px;
		margin: auto;
		padding: 150px 24px;
		display: grid;
		grid-template-columns: 180px 1fr;
		gap: 60px;
		align-items: start;
	}

	.intro-symbol {
		font-size: 8rem;
		color: #b00000;
		text-align: center;
		text-shadow: 0 0 40px rgba(170, 0, 0, 0.25);
	}

	.intro-content h2 {
		font-size: clamp(2.5rem, 5vw, 4.5rem);
		font-weight: 400;
		margin: 0;
		letter-spacing: 0.05em;
	}

	.intro-content p:not(.overline):not(.royal-introduction) {
		color: #aaa0a0;
		line-height: 1.9;
		font-size: 1.05rem;
	}

	.royal-introduction {
		font-size: 1.45rem;
		line-height: 1.7;
		color: #ffffff;
		font-style: italic;
	}


	/* QUOTE */

	.quote-section {
		padding: 140px 24px;
		text-align: center;
		background:
			linear-gradient(
				135deg,
				#120000,
				#050000 50%,
				#170000
			);
		border-top: 1px solid #350707;
		border-bottom: 1px solid #350707;
	}

	.quote-mark {
		font-size: 5rem;
		color: #a90000;
		height: 50px;
	}

	blockquote {
		max-width: 900px;
		margin: 20px auto;
		font-size: clamp(1.7rem, 4vw, 3.3rem);
		line-height: 1.35;
		font-style: italic;
		font-weight: 400;
		color: #ffffff;
	}

	.quote-section p {
		color: #c00000;
		letter-spacing: 0.25em;
		font-size: 0.75rem;
	}


	/* GENERAL SECTIONS */

	.section {
		max-width: 1200px;
		margin: auto;
		padding: 140px 24px;
	}

	.section-heading {
		text-align: center;
		margin-bottom: 70px;
	}

	.section-heading h2 {
		margin: 0;
		font-size: clamp(2.5rem, 5vw, 4.5rem);
		font-weight: 400;
		letter-spacing: 0.08em;
	}

	.section-heading p:last-child {
		color: #8e8585;
	}


	/* DOCTRINE */

	.three-columns {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 22px;
	}

	.doctrine-card {
		position: relative;
		padding: 45px 38px;
		border: 1px solid #351010;
		background:
			linear-gradient(
				145deg,
				rgba(35, 3, 3, 0.9),
				rgba(5, 2, 2, 0.95)
			);
		transition: all 0.3s ease;
	}

	.doctrine-card:hover {
		transform: translateY(-6px);
		border-color: #8d1111;
		box-shadow: 0 20px 50px rgba(100, 0, 0, 0.15);
	}

	.card-number {
		color: #b50000;
		font-size: 0.75rem;
		letter-spacing: 0.25em;
	}

	.doctrine-card h3 {
		font-size: 1.5rem;
		font-weight: 400;
		letter-spacing: 0.12em;
	}

	.doctrine-card p {
		color: #a39a9a;
		line-height: 1.8;
	}

	.doctrine-card a {
		display: inline-block;
		margin-top: 20px;
		color: #e00000;
		font-size: 0.7rem;
		letter-spacing: 0.15em;
		text-decoration: none;
	}


	/* KINGDOM */

	.kingdom-section {
		padding: 160px 24px;
		text-align: center;
		background:
			radial-gradient(
				circle at center,
				rgba(130, 0, 0, 0.18),
				transparent 60%
			),
			#080000;
		border-top: 1px solid #2d0606;
		border-bottom: 1px solid #2d0606;
	}

	.kingdom-content {
		max-width: 780px;
		margin: auto;
	}

	.kingdom-section h2 {
		font-size: clamp(2.5rem, 5vw, 4.5rem);
		font-weight: 400;
		letter-spacing: 0.08em;
	}

	.kingdom-section p:not(.overline) {
		color: #aaa0a0;
		line-height: 1.9;
		font-size: 1.05rem;
	}


	/* LORE / WORKS */

	.four-columns {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 18px;
	}

	.feature-card {
		padding: 35px 28px;
		border: 1px solid #2e0b0b;
		background: #080505;
		text-decoration: none;
		transition: all 0.3s ease;
	}

	.feature-card:hover {
		border-color: #9c1111;
		background: #120505;
		transform: translateY(-5px);
	}

	.feature-card span {
		color: #a90000;
		font-size: 0.7rem;
	}

	.feature-card h3 {
		font-size: 1.25rem;
		font-weight: 400;
		letter-spacing: 0.1em;
	}

	.feature-card p {
		color: #918888;
		line-height: 1.7;
		font-size: 0.9rem;
	}

	.feature-card strong {
		color: #e00000;
		font-size: 0.7rem;
		letter-spacing: 0.12em;
	}


	/* OFFICIAL LINKS */

	.links-section {
		padding: 140px 24px;
		background: #050303;
		border-top: 1px solid #250707;
	}

	.official-links {
		max-width: 850px;
		margin: auto;
	}

	.official-links a {
		display: grid;
		grid-template-columns: 70px 1fr 40px;
		align-items: center;
		padding: 25px 15px;
		border-bottom: 1px solid #281010;
		text-decoration: none;
		font-size: 1rem;
		letter-spacing: 0.12em;
		transition: all 0.25s ease;
	}

	.official-links a:hover {
		background: #120303;
		color: #ff2222;
		padding-left: 25px;
	}

	.official-links span {
		color: #8e0000;
		font-size: 0.7rem;
	}

	.official-links strong {
		color: #b90000;
	}


	/* SUPPORT */

	.support-section {
		padding: 150px 24px;
		text-align: center;
		background:
			radial-gradient(
				circle at center,
				rgba(120, 0, 0, 0.15),
				transparent 60%
			);
	}

	.support-content {
		max-width: 700px;
		margin: auto;
	}

	.support-section h2 {
		font-size: clamp(2.5rem, 5vw, 4rem);
		font-weight: 400;
	}

	.support-section p:not(.overline) {
		color: #aaa0a0;
		line-height: 1.9;
		margin-bottom: 35px;
	}

	.donate-button {
		background: #a90000;
		color: #ffffff;
	}

	.donate-button:hover {
		background: #e00000;
		box-shadow: 0 0 35px rgba(200, 0, 0, 0.35);
		transform: translateY(-3px);
	}


	/* CONTACT */

	.contact-section {
		padding: 150px 24px;
		text-align: center;
		background: #080303;
		border-top: 1px solid #300707;
	}

	.contact-content {
		max-width: 750px;
		margin: auto;
	}

	.contact-section h2 {
		font-size: clamp(2.3rem, 5vw, 4rem);
		font-weight: 400;
	}

	.contact-section p:not(.overline) {
		color: #968d8d;
	}

	.email {
		display: inline-block;
		margin-top: 15px;
		color: #ffffff;
		font-size: 1.1rem;
		text-decoration: none;
		border-bottom: 1px solid #8e0000;
		padding-bottom: 7px;
	}

	.email:hover {
		color: #e00000;
	}


	/* FINAL */

	.final-section {
		padding: 170px 24px;
		text-align: center;
		background:
			radial-gradient(
				circle,
				rgba(130, 0, 0, 0.18),
				transparent 55%
			),
			#020202;
	}

	.final-symbol {
		font-size: 6rem;
		color: #b50000;
		margin-bottom: 20px;
	}

	.final-section h2 {
		font-size: clamp(2rem, 5vw, 4rem);
		font-weight: 400;
		letter-spacing: 0.1em;
	}

	.final-line {
		color: #900000;
		font-size: 0.7rem;
		letter-spacing: 0.35em;
		margin-top: 25px;
	}


	/* ANIMATION */

	@keyframes bloodPulse {
		0%,
		100% {
			transform: scale(0.95);
			opacity: 0.65;
		}

		50% {
			transform: scale(1.08);
			opacity: 1;
		}
	}


	/* MOBILE */

	@media (max-width: 850px) {

		.introduction {
			grid-template-columns: 1fr;
			text-align: center;
		}

		.three-columns,
		.four-columns {
			grid-template-columns: 1fr;
		}

		.solar-crown {
			font-size: 13rem;
		}

		.hero h2 {
			letter-spacing: 0.25em;
		}

		.official-links a {
			grid-template-columns: 45px 1fr 30px;
