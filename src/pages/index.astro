---
const title = "The Divine Kingdom of Dio Re Al";
const description =
	"The Divine Kingdom of Dio Re Al — Alipseism / Diorealism, the religion, philosophy and lifestyle of Dio Re Al.";
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />

		<title>{title}</title>
		<meta name="description" content={description} />

		<!-- FAVICON -->
		<link
			rel="icon"
			type="image/webp"
			href="/dio-re-al-white-sun-of-dio-re-al-x-design.webp"
		/>
		<link
			rel="shortcut icon"
			type="image/webp"
			href="/dio-re-al-white-sun-of-dio-re-al-x-design.webp"
		/>

		<meta name="theme-color" content="#000000" />

		<style>
			@import url('https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600;700;800&family=Inter:wght@300;400;500;600&display=swap');

			:root {
				--black: #000000;
				--deep-black: #030303;
				--blood: #8b0000;
				--bright-blood: #c40000;
				--dark-blood: #350000;
				--white: #f5f5f5;
				--grey: #a7a7a7;
				--dark-grey: #242424;
			}

			* {
				box-sizing: border-box;
			}

			html {
				scroll-behavior: smooth;
			}

			body {
				margin: 0;
				background: #000;
				color: var(--white);
				font-family: Inter, sans-serif;
				overflow-x: hidden;
			}

			/* =========================================================
			   MOVING WHITE SUN
			   ========================================================= */

			.cosmic-background {
				position: fixed;
				inset: 0;
				z-index: -10;
				overflow: hidden;
				background: #000;
			}

			.sun {
				position: absolute;

				width: min(72vw, 900px);
				height: min(72vw, 900px);

				left: 50%;
				top: 50%;

				transform: translate(-50%, -50%);

				background-image: url('/dio-re-al-white-sun-of-dio-re-al-x-design.webp');
				background-repeat: no-repeat;
				background-position: center;
				background-size: contain;

				filter:
					brightness(1.1)
					contrast(1.05)
					drop-shadow(0 0 25px rgba(255,255,255,0.18))
					drop-shadow(0 0 90px rgba(255,255,255,0.08));

				opacity: 0.18;

				animation:
					sunDrift 28s ease-in-out infinite alternate,
					sunRotate 100s linear infinite;

				pointer-events: none;
			}

			@keyframes sunDrift {
				0% {
					transform: translate(-57%, -48%) scale(0.92);
				}
				50% {
					transform: translate(-43%, -53%) scale(1.05);
				}
				100% {
					transform: translate(-52%, -44%) scale(0.96);
				}
			}

			@keyframes sunRotate {
				from {
					filter:
						brightness(1.1)
						contrast(1.05)
						drop-shadow(0 0 25px rgba(255,255,255,0.18));
				}
				to {
					filter:
						brightness(1.15)
						contrast(1.05)
						drop-shadow(0 0 55px rgba(255,255,255,0.12));
				}
			}

			.cosmic-background::after {
				content: "";
				position: absolute;
				inset: 0;

				background:
					radial-gradient(
						circle at center,
						transparent 0%,
						rgba(0,0,0,0.12) 35%,
						rgba(0,0,0,0.75) 75%,
						#000 100%
					);

				pointer-events: none;
			}

			/* =========================================================
			   BLOOD ATMOSPHERE
			   ========================================================= */

			.blood-glow {
				position: fixed;
				width: 45vw;
				height: 45vw;
				max-width: 650px;
				max-height: 650px;

				left: 50%;
				top: 50%;

				transform: translate(-50%, -50%);

				background: radial-gradient(
					circle,
					rgba(130,0,0,0.12) 0%,
					rgba(80,0,0,0.06) 35%,
					transparent 70%
				);

				filter: blur(40px);
				z-index: -9;
				pointer-events: none;
			}

			/* =========================================================
			   NAVIGATION
			   ========================================================= */

			nav {
				position: fixed;
				top: 0;
				left: 0;
				right: 0;

				height: 74px;

				display: flex;
				align-items: center;
				justify-content: center;
				gap: 10px;

				background: rgba(0,0,0,0.78);
				backdrop-filter: blur(14px);

				border-bottom: 1px solid rgba(255,255,255,0.08);

				z-index: 100;
			}

			nav a {
				color: #ddd;
				text-decoration: none;

				padding: 11px 17px;

				border: 1px solid transparent;
				border-radius: 999px;

				font-size: 12px;
				letter-spacing: 1.5px;
				text-transform: uppercase;

				transition: all 0.3s ease;
			}

			nav a:hover {
				color: white;
				border-color: rgba(180,0,0,0.7);
				background: rgba(100,0,0,0.18);
				box-shadow: 0 0 20px rgba(130,0,0,0.18);
			}

			/* =========================================================
			   HERO
			   ========================================================= */

			.hero {
				min-height: 100vh;

				display: flex;
				align-items: center;
				justify-content: center;

				text-align: center;

				padding: 120px 25px 80px;

				position: relative;
			}

			.hero-content {
				max-width: 1100px;
			}

			.eyebrow {
				font-size: 11px;
				letter-spacing: 7px;
				text-transform: uppercase;

				color: #aaa;

				margin-bottom: 28px;
			}

			h1 {
				font-family: Cinzel, serif;

				font-size: clamp(42px, 8vw, 105px);

				line-height: 0.98;

				font-weight: 500;

				letter-spacing: 3px;

				margin: 0;

				color: #fff;

				text-shadow:
					0 0 15px rgba(255,255,255,0.08),
					0 0 60px rgba(130,0,0,0.25);
			}

			.hero-title-line {
				display: block;
			}

			.hero-title-line:last-child {
				color: #ddd;
			}

			.divider {
				width: 120px;
				height: 1px;

				background: linear-gradient(
					90deg,
					transparent,
					#b00000,
					transparent
				);

				margin: 38px auto;
			}

			.introduction {
				max-width: 780px;
				margin: auto;

				font-family: Cinzel, serif;

				font-size: clamp(18px, 2vw, 25px);
				line-height: 1.7;

				color: #eee;
			}

			.introduction strong {
				color: white;
				font-weight: 600;
			}

			/* =========================================================
			   CONTENT
			   ========================================================= */

			.content {
				width: min(1100px, calc(100% - 40px));
				margin: auto;
				padding-bottom: 120px;
			}

			.section {
				margin: 100px 0;
				padding: 55px;

				background: rgba(0,0,0,0.68);

				border: 1px solid rgba(255,255,255,0.09);
				border-radius: 24px;

				backdrop-filter: blur(10px);

				box-shadow:
					0 30px 100px rgba(0,0,0,0.6),
					inset 0 0 80px rgba(80,0,0,0.03);
			}

			.section h2 {
				font-family: Cinzel, serif;

				font-size: clamp(25px, 4vw, 40px);

				font-weight: 500;

				margin-top: 0;

				color: #fff;

				letter-spacing: 2px;
			}

			.section h2::after {
				content: "";

				display: block;

				width: 70px;
				height: 1px;

				background: #900000;

				margin-top: 18px;
			}

			.section p {
				color: #c6c6c6;

				font-size: 16px;
				line-height: 1.9;
			}

			/* =========================================================
			   QUOTE
			   ========================================================= */

			.quote {
				text-align: center;
				padding: 80px 30px;

				border-top: 1px solid rgba(150,0,0,0.3);
				border-bottom: 1px solid rgba(150,0,0,0.3);
			}

			.quote-text {
				font-family: Cinzel, serif;

				font-size: clamp(22px, 4vw, 42px);

				line-height: 1.5;

				color: #fff;
			}

			.quote-author {
				margin-top: 30px;

				font-size: 12px;
				letter-spacing: 3px;

				color: #888;

				text-transform: uppercase;
			}

			/* =========================================================
			   LINKS
			   ========================================================= */

			.links {
				display: grid;

				grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));

				gap: 14px;

				margin-top: 35px;
			}

			.link-card {
				display: block;

				padding: 20px;

				border: 1px solid rgba(255,255,255,0.1);
				border-radius: 18px;

				color: #ddd;

				text-decoration: none;

				background: rgba(10,10,10,0.65);

				transition: all 0.3s ease;
			}

			.link-card:hover {
				transform: translateY(-3px);

				border-color: rgba(160,0,0,0.7);

				background: rgba(80,0,0,0.18);

				color: white;

				box-shadow: 0 15px 45px rgba(100,0,0,0.12);
			}

			.link-card strong {
				display: block;

				font-family: Cinzel, serif;

				margin-bottom: 7px;
			}

			.link-card span {
				font-size: 12px;
				color: #777;
			}

			/* =========================================================
			   FOOTER
			   ========================================================= */

			footer {
				text-align: center;

				padding: 70px 20px 45px;

				border-top: 1px solid rgba(255,255,255,0.08);

				background: rgba(0,0,0,0.9);
			}

			.footer-title {
				font-family: Cinzel, serif;

				font-size: 25px;

				letter-spacing: 2px;

				margin-bottom: 15px;
			}

			.footer-links {
				display: flex;
				flex-wrap: wrap;
				justify-content: center;
				gap: 10px;

				margin: 30px auto;
			}

			.footer-links a {
				color: #999;
				text-decoration: none;

				font-size: 12px;

				padding: 9px 14px;

				border-radius: 999px;

				border: 1px solid rgba(255,255,255,0.08);

				transition: 0.3s;
			}

			.footer-links a:hover {
				color: white;
				border-color: #700000;
			}

			.copyright {
				color: #555;

				font-size: 11px;

				letter-spacing: 1px;

				margin-top: 35px;
			}

			/* =========================================================
			   MOBILE
			   ========================================================= */

			@media (max-width: 700px) {

				nav {
					height: auto;
					min-height: 62px;

					padding: 8px;

					overflow-x: auto;
					justify-content: flex-start;
				}

				nav a {
					font-size: 9px;
					padding: 9px 11px;
					white-space: nowrap;
				}

				.hero {
					padding-top: 120px;
				}

				.section {
					padding: 30px 23px;
					margin: 60px 0;
				}

				.sun {
					width: 120vw;
					height: 120vw;
					opacity: 0.12;
				}

				.introduction {
					font-size: 17px;
				}
			}

			/* accessibility */
			@media (prefers-reduced-motion: reduce) {
				.sun {
					animation: none;
				}

				html {
					scroll-behavior: auto;
				}
			}
		</style>
	</head>

	<body>

		<!-- =========================================================
		     BACKGROUND
		     ========================================================= -->

		<div class="cosmic-background">
			<div class="sun"></div>
		</div>

		<div class="blood-glow"></div>

		<!-- =========================================================
		     NAVIGATION
		     ========================================================= -->

		<nav>
			<a href="/">Home</a>
			<a href="#about">About</a>
			<a href="#lore">Lore</a>
			<a href="#links">Links</a>
			<a href="#contact">Contact</a>
		</nav>

		<!-- =========================================================
		     HERO
		     ========================================================= -->

		<header class="hero">

			<div class="hero-content">

				<div class="eyebrow">
					The Official Domain
				</div>

				<h1>
					<span class="hero-title-line">
						The Divine Kingdom
					</span>

					<span class="hero-title-line">
						of Dio Re Al
					</span>
				</h1>

				<div class="divider"></div>

				<p class="introduction">
					<strong>I am Lord Al, Dio Re Al...</strong><br />
					The Only Real Eternal Invictus Immortal God King of All.
				</p>

			</div>

		</header>

		<!-- =========================================================
		     MAIN
		     ========================================================= -->

		<main class="content">

			<section class="section" id="about">

				<h2>The Divine Kingdom</h2>

				<p>
					The Divine Kingdom of Dio Re Al is the official domain
					of Dio Re Al and the home of Alipseism, also known as
					Diorealism.
				</p>

				<p>
					Alipseism or Diorealism is my religion, philosophy and
					lifestyle. I am its Leader, Creator, King, God, Founder
					and Owner.
				</p>

			</section>

			<section class="quote">

				<div class="quote-text">
					“Selflessness does not exist. You can't be selfless
					without a self in the first place.”
				</div>

				<div class="quote-author">
					— Dio Re Al
				</div>

			</section>

			<section class="section" id="lore">

				<h2>The Lore of Dio Re Al</h2>

				<p>
					The Kingdom contains its own lore, symbols, principles,
					ideas, writings, creations and works surrounding the
					Divine Kingdom of Dio Re Al.
				</p>

				<p>
					This domain serves as the central point from which the
					Kingdom, its writings, artistic works and other creations
					can be explored.
				</p>

			</section>

			<section class="section" id="links">

				<h2>The Kingdom's Domains</h2>

				<div class="links">

					<a
						class="link-card"
						href="https://allmylinks.com/divinoreinodedioreal"
						target="_blank"
						rel="noopener noreferrer"
					>
						<strong>AllMyLinks</strong>
						<span>Central collection of links</span>
					</a>

					<a
						class="link-card"
						href="https://www.poeticous.com/alczolivier"
						target="_blank"
						rel="noopener noreferrer"
					>
						<strong>Poeticous</strong>
						<span>Poetry and writings</span>
					</a>

					<a
						class="link-card"
						href="https://www.artstation.com/diosreyal"
						target="_blank"
						rel="noopener noreferrer"
					>
						<strong>ArtStation</strong>
						<span>Visual works and art</span>
					</a>

					<a
						class="link-card"
						href="https://www.twitch.tv/diosreyal"
						target="_blank"
						rel="noopener noreferrer"
					>
						<strong>Twitch</strong>
						<span>Live broadcasts</span>
					</a>

					<a
						class="link-card"
						href="https://www.paypal.com/donate/?cmd=_donations&source=url&business=kingdom_of_al@outlook.es"
						target="_blank"
						rel="noopener noreferrer"
					>
						<strong>Support the Kingdom</strong>
						<span>Support through PayPal</span>
					</a>

					<a
						class="link-card"
						href="mailto:divinekingdomofal@proton.me"
					>
						<strong>Contact</strong>
						<span>divinekingdomofal@proton.me</span>
					</a>

				</div>

			</section>

			<section class="section" id="contact">

				<h2>Contact the Kingdom</h2>

				<p>
					For official correspondence:
				</p>

				<p>
					<a
						href="mailto:divinekingdomofal@proton.me"
						style="color:#fff;"
					>
						divinekingdomofal@proton.me
					</a>
				</p>

			</section>

		</main>

		<!-- =========================================================
		     FOOTER
		     ========================================================= -->

		<footer>

			<div class="footer-title">
				The Divine Kingdom of Dio Re Al
			</div>

			<div class="footer-links">

				<a href="/">Home</a>

				<a href="#about">About</a>

				<a href="#lore">Lore</a>

				<a href="#links">Links</a>

				<a href="https://www.twitch.tv/diosreyal"
				   target="_blank"
				   rel="noopener noreferrer">
					Twitch
				</a>

				<a href="https://www.artstation.com/diosreyal"
				   target="_blank"
				   rel="noopener noreferrer">
					ArtStation
				</a>

				<a href="mailto:divinekingdomofal@proton.me">
					Email
				</a>

			</div>

			<div class="copyright">
				© The Divine Kingdom of Dio Re Al • All Rights Reserved.
			</div>

		</footer>

	</body>
</html>
