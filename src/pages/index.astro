---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
<head>

	<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />

	<!-- =========================================
	     FAVICON
	     ========================================= -->

	<link
		rel="icon"
		type="image/png"
		sizes="512x512"
		href="/favicon.png"
	/>

	<link
		rel="apple-touch-icon"
		href="/favicon.png"
	/>

	<meta name="theme-color" content="#030303" />
	<meta name="color-scheme" content="dark" />

	<style>

		/* =========================================================
		   DIVINE KINGDOM OF DIO RE AL
		   ORIGINAL VISUAL SYSTEM
		   ========================================================= */

		:root {
			--void: #020202;
			--black: #050505;
			--black-red: #0b0000;

			--blood-dark: #380000;
			--blood: #720000;
			--blood-light: #b30000;
			--blood-hot: #e00000;

			--white: #f4f2ed;
			--ivory: #dedbd3;
			--silver: #a7a7a7;
			--gray: #686868;

			--line: rgba(255,255,255,.13);

			--serif: Georgia, "Times New Roman", serif;
			--sans: Arial, Helvetica, sans-serif;
		}


		/* =========================================================
		   RESET
		   ========================================================= */

		* {
			box-sizing: border-box;
		}

		html {
			scroll-behavior: smooth;
			background: var(--void);
		}

		body {
			margin: 0;
			padding: 0;

			color: var(--white);

			background:
				radial-gradient(
					ellipse at 50% 15%,
					rgba(100,0,0,.16),
					transparent 38%
				),
				radial-gradient(
					ellipse at 15% 70%,
					rgba(100,0,0,.08),
					transparent 35%
				),
				linear-gradient(
					180deg,
					#020202 0%,
					#080000 40%,
					#020202 100%
				);

			font-family: var(--serif);

			overflow-x: hidden;
		}

		body::before {
			content: "";

			position: fixed;
			inset: 0;

			pointer-events: none;
			z-index: 50;

			background:
				linear-gradient(
					rgba(255,255,255,.012) 1px,
					transparent 1px
				);

			background-size: 100% 4px;

			opacity: .12;
		}

		a {
			color: inherit;
			text-decoration: none;
		}

		img {
			max-width: 100%;
		}


		/* =========================================================
		   BACKGROUND ATMOSPHERE
		   ========================================================= */

		.void {

			position: fixed;

			inset: 0;

			z-index: 0;

			pointer-events: none;

			overflow: hidden;
		}


		/* rotating transparent Sun */

		.sun {

			position: absolute;

			width: min(90vw, 1000px);
			height: min(90vw, 1000px);

			left: 50%;
			top: 48%;

			transform: translate(-50%, -50%);

			opacity: .075;

			filter:
				drop-shadow(
					0 0 25px
					rgba(255,255,255,.35)
				)
				drop-shadow(
					0 0 100px
					rgba(170,0,0,.5)
				);

			animation:
				sunDrift 20s ease-in-out infinite;
		}

		.sun img {

			width: 100%;
			height: 100%;

			object-fit: contain;

			animation:
				sunRotation 110s linear infinite;
		}


		@keyframes sunRotation {

			from {
				transform: rotate(0deg);
			}

			to {
				transform: rotate(360deg);
			}
		}


		@keyframes sunDrift {

			0%,100% {
				transform:
					translate(-50%,-50%)
					scale(1);
			}

			50% {
				transform:
					translate(-50%,-51%)
					scale(1.035);
			}
		}


		/* =========================================================
		   RED AURA
		   ========================================================= */

		.aura {

			position: absolute;

			width: 700px;
			height: 700px;

			left: 50%;
			top: 45%;

			transform: translate(-50%,-50%);

			border-radius: 50%;

			background:
				radial-gradient(
					circle,
					rgba(120,0,0,.18),
					transparent 68%
				);

			filter: blur(30px);

			animation: auraPulse 9s ease-in-out infinite;
		}

		@keyframes auraPulse {

			0%,100% {
				opacity: .4;
				transform:
					translate(-50%,-50%)
					scale(1);
			}

			50% {
				opacity: .8;
				transform:
					translate(-50%,-50%)
					scale(1.15);
			}
		}


		/* =========================================================
		   STAR / PARTICLE FIELD
		   ========================================================= */

		.stars {

			position: absolute;
			inset: 0;

			background-image:
				radial-gradient(
					1px 1px at 20% 30%,
					rgba(255,255,255,.6),
					transparent
				),
				radial-gradient(
					1px 1px at 70% 20%,
					rgba(255,255,255,.45),
					transparent
				),
				radial-gradient(
					1px 1px at 40% 75%,
					rgba(255,255,255,.5),
					transparent
				),
				radial-gradient(
					1px 1px at 85% 65%,
					rgba(255,255,255,.4),
					transparent
				);

			background-size:
				320px 320px,
				450px 450px,
				520px 520px,
				380px 380px;

			opacity: .35;
		}


		/* =========================================================
		   MAIN
		   ========================================================= */

		.site {

			position: relative;

			z-index: 2;
		}


		/* =========================================================
		   NAVIGATION
		   ========================================================= */

		.navigation {

			position: fixed;

			top: 0;
			left: 0;
			right: 0;

			z-index: 100;

			display: flex;

			justify-content: center;
			align-items: center;

			gap: 28px;

			padding: 18px 25px;

			background:
				rgba(2,2,2,.78);

			border-bottom:
				1px solid
				rgba(255,255,255,.1);

			backdrop-filter: blur(15px);
		}

		.navigation a {

			font-family: var(--sans);

			font-size: 10px;

			letter-spacing: 3px;

			text-transform: uppercase;

			color: var(--silver);

			transition: .35s;

			padding: 9px 15px;

			border-radius: 999px;
		}

		.navigation a:hover {

			color: white;

			background:
				rgba(120,0,0,.35);

			box-shadow:
				0 0 20px
				rgba(160,0,0,.25);
		}


		/* =========================================================
		   HERO
		   ========================================================= */

		.hero {

			min-height: 100vh;

			display: flex;

			align-items: center;
			justify-content: center;

			text-align: center;

			padding:
				130px 25px
				100px;

			position: relative;
		}


		.hero-inner {

			max-width: 1200px;

			position: relative;

			z-index: 3;
		}


		/* little solar symbol */

		.hero-symbol {

			width: 110px;
			height: 110px;

			object-fit: contain;

			margin-bottom: 35px;

			filter:
				drop-shadow(
					0 0 15px
					rgba(255,255,255,.6)
				)
				drop-shadow(
					0 0 35px
					rgba(180,0,0,.6)
				);

			animation:
				symbolPulse 6s ease-in-out infinite;
		}


		@keyframes symbolPulse {

			0%,100% {
				transform: scale(1);
			}

			50% {
				transform: scale(1.07);
			}
		}


		/* =========================================================
		   HERO TYPOGRAPHY
		   ========================================================= */

		.eyebrow {

			font-family: var(--sans);

			font-size: 10px;

			letter-spacing: 8px;

			color: var(--silver);

			text-transform: uppercase;

			margin-bottom: 25px;
		}


		.hero h1 {

			margin: 0;

			font-family: var(--serif);

			font-size:
				clamp(
					50px,
					9vw,
					125px
				);

			line-height: .88;

			font-weight: normal;

			letter-spacing: -5px;

			text-transform: uppercase;

			color: white;

			text-shadow:
				0 0 20px
				rgba(255,255,255,.08),

				0 0 80px
				rgba(130,0,0,.35);
		}


		.hero h1 .divine {

			display: block;
		}


		.hero h1 .kingdom {

			display: block;

			color: var(--blood-hot);

			font-size: .52em;

			letter-spacing: 9px;

			margin-top: 25px;

			text-shadow:
				0 0 30px
				rgba(220,0,0,.45);
		}


		.hero h1 .of {

			display: block;

			font-size: .24em;

			letter-spacing: 8px;

			color: var(--silver);

			margin-top: 20px;

			font-family: var(--sans);
		}


		.hero-line {

			width: 220px;

			height: 1px;

			margin:
				45px
				auto
				35px;

			background:
				linear-gradient(
					90deg,
					transparent,
					white,
					var(--blood-hot),
					white,
					transparent
				);
		}


		.hero-subtitle {

			font-family: var(--sans);

			font-size: 11px;

			letter-spacing: 5px;

			color: #999;

			text-transform: uppercase;
		}


		/* =========================================================
		   BUTTONS
		   ========================================================= */

		.buttons {

			display: flex;

			justify-content: center;

			flex-wrap: wrap;

			gap: 12px;

			margin-top: 40px;
		}


		.button {

			display: inline-block;

			padding:
				13px
				23px;

			border:
				1px solid
				rgba(255,255,255,.25);

			border-radius: 999px;

			font-family: var(--sans);

			font-size: 10px;

			letter-spacing: 2px;

			text-transform: uppercase;

			transition: .35s;
		}


		.button:hover {

			background:
				var(--blood);

			border-color:
				var(--blood-hot);

			box-shadow:
				0 0 30px
				rgba(190,0,0,.3);

			transform:
				translateY(-2px);
		}


		.button.blood {

			border-color:
				var(--blood-light);

			background:
				rgba(90,0,0,.2);
		}


		/* =========================================================
		   INTRO
		   ========================================================= */

		.introduction {

			max-width: 1050px;

			margin: auto;

			padding:
				130px 25px;
		}


		.section-label {

			font-family: var(--sans);

			font-size: 9px;

			letter-spacing: 6px;

			text-transform: uppercase;

			color: var(--blood-hot);

			text-align: center;

			margin-bottom: 20px;
		}


		.section-title {

			text-align: center;

			font-size:
				clamp(
					35px,
					5vw,
					60px
				);

			font-weight: normal;

			letter-spacing: 3px;

			text-transform: uppercase;

			margin: 0;
		}


		.section-description {

			max-width: 700px;

			margin:
				30px
				auto;

			text-align: center;

			color: #aaa;

			line-height: 1.9;

			font-size: 17px;
		}


		/* =========================================================
		   DIO RE AL QUOTE
		   ========================================================= */

		.quote {

			position: relative;

			margin:
				70px
				auto;

			max-width: 900px;

			padding:
				55px
				50px;

			text-align: center;

			background:
				linear-gradient(
					135deg,
					rgba(90,0,0,.13),
					rgba(0,0,0,.35)
				);

			border:
				1px solid
				rgba(255,255,255,.1);

			border-radius: 28px;

			box-shadow:
				0 30px 100px
				rgba(0,0,0,.4);
		}


		.quote::before {

			content: "“";

			position: absolute;

			left: 25px;
			top: -15px;

			font-size: 100px;

			color: var(--blood);

			opacity: .65;
		}


		.quote p {

			margin: 0;

			font-size:
				clamp(
					20px,
					3vw,
					31px
				);

			font-style: italic;

			line-height: 1.55;
		}


		.quote-author {

			display: block;

			margin-top: 25px;

			font-family: var(--sans);

			font-size: 10px;

			letter-spacing: 4px;

			color: var(--silver);

			text-transform: uppercase;
		}


		/* =========================================================
		   CARDS
		   ========================================================= */

		.section {

			max-width: 1200px;

			margin: auto;

			padding:
				110px 25px;
		}


		.cards {

			display: grid;

			grid-template-columns:
				repeat(3, 1fr);

			gap: 18px;

			margin-top: 55px;
		}


		.card {

			position: relative;

			padding:
				40px 32px;

			min-height: 220px;

			background:
				linear-gradient(
					145deg,
					rgba(40,0,0,.42),
					rgba(5,5,5,.75)
				);

			border:
				1px solid
				rgba(255,255,255,.11);

			border-radius: 25px;

			overflow: hidden;

			transition:
				.45s;
		}


		.card::before {

			content: "";

			position: absolute;

			top: 0;
			left: 25px;
			right: 25px;

			height: 1px;

			background:
				linear-gradient(
					90deg,
					transparent,
					var(--blood),
					transparent
				);

			opacity: .7;
		}


		.card:hover {

			transform:
				translateY(-7px);

			border-color:
				rgba(190,0,0,.55);

			box-shadow:
				0 25px 70px
				rgba(100,0,0,.22);
		}


		.card-number {

			font-family: var(--sans);

			font-size: 10px;

			color: var(--blood-hot);

			letter-spacing: 3px;
		}


		.card h3 {

			margin:
				20px 0;

			font-size: 23px;

			font-weight: normal;

			letter-spacing: 2px;

			text-transform: uppercase;
		}


		.card p {

			color: #999;

			line-height: 1.8;

			font-size: 15px;
		}


		/* =========================================================
		   COSMIC ARCHIVE
		   ========================================================= */

		.archive {

			max-width: 950px;

			margin: auto;

			padding:
				120px 25px;
		}


		.archive-list {

			margin-top: 50px;

			border-top:
				1px solid
				var(--line);
		}


		.archive-item {

			display: flex;

			align-items: center;

			justify-content: space-between;

			gap: 30px;

			padding:
				24px 5px;

			border-bottom:
				1px solid
				var(--line);

			transition: .3s;
		}


		.archive-item:hover {

			padding-left: 15px;

			background:
				linear-gradient(
					90deg,
					rgba(100,0,0,.12),
					transparent
				);
		}


		.archive-item span:first-child {

			font-size: 18px;

			color: var(--white);
		}


		.archive-item span:last-child {

			font-family: var(--sans);

			font-size: 9px;

			letter-spacing: 3px;

			color: var(--blood-hot);

			text-transform: uppercase;
		}


		/* =========================================================
		   OFFICIAL LINKS
		   ========================================================= */

		.links-section {

			text-align: center;

			padding:
				120px 25px;
		}


		.links-grid {

			max-width: 900px;

			margin:
				50px
				auto
				0;

			display: flex;

			justify-content: center;

			flex-wrap: wrap;

			gap: 12px;
		}


		/* =========================================================
		   CONTACT
		   ========================================================= */

		.contact {

			max-width: 700px;

			margin: auto;

			text-align: center;

			padding:
				110px 25px
				140px;
		}


		.email {

			display: inline-block;

			margin-top: 30px;

			font-family: var(--sans);

			font-size: 14px;

			letter-spacing: 2px;

			color: var(--white);

			padding:
				15px 25px;

			border:
				1px solid
				rgba(255,255,255,.2);

			border-radius: 999px;

			transition: .3s;
		}


		.email:hover {

			border-color:
				var(--blood-hot);

			background:
				rgba(100,0,0,.25);
		}


		/* =========================================================
		   FOOTER
		   ========================================================= */

		footer {

			padding:
				80px 25px;

			text-align: center;

			border-top:
				1px solid
				var(--line);

			background:
				rgba(0,0,0,.5);
		}


		.footer-symbol {

			width: 60px;
			height: 60px;

			object-fit: contain;

			margin-bottom: 25px;

			opacity: .85;
		}


		footer h3 {

			font-weight: normal;

			font-size: 20px;

			letter-spacing: 4px;

			text-transform: uppercase;
		}


		.footer-subtitle {

			font-family: var(--sans);

			font-size: 9px;

			letter-spacing: 4px;

			color: #777;

			text-transform: uppercase;
		}


		.copyright {

			margin-top: 35px;

			font-family: var(--sans);

			font-size: 10px;

			letter-spacing: 1px;

			color: #555;
		}


		/* =========================================================
		   MOBILE
		   ========================================================= */

		@media (max-width: 800px) {

			.navigation {

				gap: 3px;

				padding:
					10px 8px;

				flex-wrap: wrap;
			}


			.navigation a {

				font-size: 8px;

				letter-spacing: 1px;

				padding:
					7px 9px;
			}


			.hero {

				padding:
					140px 20px
					90px;
			}


			.hero h1 {

				letter-spacing: -2px;
			}


			.hero h1 .kingdom {

				letter-spacing: 4px;
			}


			.hero h1 .of {

				letter-spacing: 4px;
			}


			.sun {

				width: 125vw;
				height: 125vw;

				opacity: .055;
			}


			.cards {

				grid-template-columns:
					1fr;
			}


			.quote {

				padding:
					45px 25px;
			}


			.archive-item {

				align-items: flex-start;

				flex-direction: column;

				gap: 8px;
			}


			.links-grid {

				gap: 9px;
			}
		}


		/* =========================================================
		   ACCESSIBILITY
		   ========================================================= */

		@media (prefers-reduced-motion: reduce) {

			.sun,
			.sun img,
			.aura,
			.hero-symbol {

				animation: none;
			}
		}

	</style>

</head>


<body>


	<!-- =========================================================
	     BACKGROUND
	     ========================================================= -->

	<div class="void" aria-hidden="true">

		<div class="stars"></div>

		<div class="aura"></div>

		<div class="sun">

			<img
				src="/dio-re-al-sun-transparent.png"
				alt=""
			/>

		</div>

	</div>


	<div class="site">


		<!-- =====================================================
		     NAVIGATION
		     ===================================================== -->

		<nav class="navigation">

			<a href="/">Home</a>

			<a href="#dio-re-al">
				Dio Re Al
			</a>

			<a href="#alipseism">
				Alipseism
			</a>

			<a href="#kingdom">
				Kingdom
			</a>

			<a href="#archive">
				Archive
			</a>

			<a href="#contact">
				Contact
			</a>

		</nav>


		<!-- =====================================================
		     HERO
		     ===================================================== -->

		<header class="hero">

			<div class="hero-inner">


				<img
					class="hero-symbol"
					src="/dio-re-al-sun-transparent.png"
					alt="Sun of Dio Re Al"
				/>


				<div class="eyebrow">

					The Official Domain

				</div>


				<h1>

					<span class="divine">
						Divine
					</span>

					<span class="divine">
						Kingdom
					</span>

					<span class="of">
						OF
					</span>

					<span class="kingdom">
						DIO RE AL
					</span>

				</h1>


				<div class="hero-line"></div>


				<div class="hero-subtitle">

					ETERNAL · INVICTUS · IMMORTAL

				</div>


				<div class="buttons">

					<a
						class="button blood"
						href="#dio-re-al"
					>
						Enter the Kingdom
					</a>


					<a
						class="button"
						href="https://allmylinks.com/divinoreinodedioreal"
						target="_blank"
						rel="noopener noreferrer"
					>
						All My Links
					</a>

				</div>


			</div>

		</header>


		<!-- =====================================================
		     DIO RE AL
		     ===================================================== -->

		<section
			class="introduction"
			id="dio-re-al"
		>

			<div class="section-label">
				The Sovereign
			</div>


			<h2 class="section-title">
				Dio Re Al
			</h2>


			<p class="section-description">

				I am Lord Al, Dio Re Al...
				The Only Real Eternal Invictus Immortal God King of All.

			</p>


			<div class="quote">

				<p>

					“Selflessness does not exist.
					You can't be selfless without a self
					in the first place.”

				</p>


				<span class="quote-author">

					— Dio Re Al

				</span>

			</div>


		</section>


		<!-- =====================================================
		     ALIPSEISM
		     ===================================================== -->

