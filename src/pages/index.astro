---
import BaseHead from '../components/BaseHead.astro';

const SITE_TITLE = 'Divine Kingdom of Dio Re Al';
const SITE_DESCRIPTION =
	'The official website of the Divine Kingdom of Dio Re Al — Alipseism / Diorealism.';

const posts = [
	{
		date: 'August 15, 2026',
		title: 'The Divine Kingdom',
		content: `
			<p>
				Welcome to the <strong>Divine Kingdom of Dio Re Al</strong>,
				the official home of Alipseism / Diorealism.
			</p>

			<p>
				This is the place for the philosophy, writings, lore, artwork,
				poetry, music and creations of Dio Re Al.
			</p>

			<p>
				Explore the Kingdom, discover its writings, and enter the world
				of Dio Re Al.
			</p>
		`
	},
	{
		date: 'The Eternal Declaration',
		title: 'I am Lord Al, Dio Re Al...',
		content: `
			<blockquote>
				I am Lord Al, Dio Re Al... The Only Real Eternal Invictus
				Immortal God King of All.
			</blockquote>

			<p class="quote-author">
				— Dio Re Al
			</p>
		`
	},
	{
		date: 'The Philosophy',
		title: 'Alipseism / Diorealism',
		content: `
			<p>
				<strong>Alipseism or Diorealism</strong> is my
				religion, philosophy and lifestyle.
			</p>

			<p>
				I am its Leader, Creator, King, God, Founder and Owner.
			</p>

			<p>
				The Divine Kingdom of Dio Re Al represents a personal system
				of thought, creation, symbolism, philosophy and spiritual
				expression.
			</p>
		`
	},
	{
		date: 'A Principle',
		title: 'Selflessness Does Not Exist',
		content: `
			<blockquote>
				“Selflessness does not exist. You can't be selfless without
				a self in the first place.”
			</blockquote>

			<p class="quote-author">
				— Dio Re Al
			</p>
		`
	}
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

		<link
			href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600;700;800&family=Inter:wght@300;400;500;600&display=swap"
			rel="stylesheet"
		/>
	</head>

	<body>

		<div class="blood-glow"></div>

		<!-- MOBILE HEADER -->
		<header class="mobile-header">
			<div class="mobile-symbol">
				<img
					src="/dio-re-al-white-sun-of-dio-re-al-x-design.webp"
					alt="Dio Re Al White Sun"
				/>
			</div>

			<div>
				<div class="mobile-title">DIO RE AL</div>
				<div class="mobile-subtitle">DIVINE KINGDOM</div>
			</div>
		</header>


		<!-- SIDEBAR -->
		<aside class="sidebar">

			<div class="solar-symbol">
				<img
					src="/dio-re-al-white-sun-of-dio-re-al-x-design.webp"
					alt="Dio Re Al White Sun"
				/>
			</div>

			<div class="kingdom-title">
				DIVINE<br />
				KINGDOM
			</div>

			<div class="of-text">
				OF
			</div>

			<div class="dio-title">
				DIO RE AL
			</div>

			<div class="red-line"></div>

			<p class="sidebar-description">
				The official domain of<br />
				Dio Re Al
			</p>

			<nav class="navigation">

				<a href="#home">
					<span>01</span>
					Home
				</a>

				<a href="#about">
					<span>02</span>
					About
				</a>

				<a href="#philosophy">
					<span>03</span>
					Alipseism
				</a>

				<a href="#lore">
					<span>04</span>
					Lore
				</a>

				<a href="#creations">
					<span>05</span>
					Creations
				</a>

				<a href="#links">
					<span>06</span>
					Links
				</a>

				<a href="#contact">
					<span>07</span>
					Contact
				</a>

			</nav>

			<div class="sidebar-social">

				<a
					href="https://www.twitch.tv/diosreyal"
					target="_blank"
					rel="noopener noreferrer"
				>
					Twitch
				</a>

				<a
					href="https://www.artstation.com/diosreyal"
					target="_blank"
					rel="noopener noreferrer"
				>
					ArtStation
				</a>

				<a
					href="https://www.poeticous.com/alczolivier"
					target="_blank"
					rel="noopener noreferrer"
				>
					Poetry
				</a>

			</div>

			<div class="sidebar-bottom">
				<img
					src="/dio-re-al-white-sun-of-dio-re-al-x-design.webp"
					alt=""
				/>
			</div>

		</aside>


		<!-- MAIN CONTENT -->
		<main class="content" id="home">


			<!-- HERO -->
			<section class="hero">

				<div class="hero-small">
					THE OFFICIAL DOMAIN
				</div>

				<h1>
					DIVINE KINGDOM
					<span>OF DIO RE AL</span>
				</h1>

				<div class="hero-line"></div>

				<p>
					ETERNAL · INVICTUS · IMMORTAL
				</p>

			</section>


			<!-- INTRODUCTION -->
			<section class="introduction" id="about">

				<div class="section-number">I</div>

				<h2>
					I AM LORD AL
				</h2>

				<div class="blood-divider"></div>

				<p class="large-text">
					I am <strong>Lord Al, Dio Re Al</strong>...
					The Only Real Eternal Invictus Immortal God King of All.
				</p>

				<p>
					This website is the official domain of the
					<strong>Divine Kingdom of Dio Re Al</strong>.
				</p>

			</section>


			<!-- POSTS -->
			<div class="posts">

				{posts.map((post, index) => (
					<article class="post">

						<div class="post-number">
							{String(index + 1).padStart(2, '0')}
						</div>

						<div class="post-date">
							{post.date}
						</div>

						<h2>
							{post.title}
						</h2>

						<div class="post-line"></div>

						<div
							class="post-content"
							set:html={post.content}
						/>

					</article>
				))}

			</div>


			<!-- PHILOSOPHY -->
			<section class="philosophy" id="philosophy">

				<div class="section-number">II</div>

				<div class="section-label">
					THE PHILOSOPHY
				</div>

				<h2>
					ALIPSEISM
				</h2>

				<div class="alternate-name">
					ALSO KNOWN AS DIOREALISM
				</div>

				<div class="blood-divider"></div>

				<p>
					Alipseism or Diorealism is my religion, philosophy,
					and lifestyle.
				</p>

				<p>
					I am the Leader, Creator, King, God, Founder and Owner
					of Alipseism / Diorealism.
				</p>

				<div class="principle-box">

					<div class="principle-symbol">
						☉
					</div>

					<div>
						<div class="principle-title">
							SELF
						</div>

						<p>
							“Selflessness does not exist. You can't be
							selfless without a self in the first place.”
						</p>

						<span>
							— DIO RE AL
						</span>
					</div>

				</div>

			</section>


			<!-- LORE -->
			<section class="lore" id="lore">

				<div class="section-number">III</div>

				<div class="section-label">
					THE KINGDOM
				</div>

				<h2>
					LORE
				</h2>

				<div class="blood-divider"></div>

				<p>
					Enter the writings, history, symbols, characters,
					kingdoms and creations of the Divine Kingdom of Dio Re Al.
				</p>

				<div class="lore-grid">

					<div class="lore-card">
						<span>01</span>
						<h3>THE KING</h3>
						<p>Dio Re Al</p>
					</div>

					<div class="lore-card">
						<span>02</span>
						<h3>THE KINGDOM</h3>
						<p>Divine Kingdom</p>
					</div>

					<div class="lore-card">
						<span>03</span>
						<h3>THE WRITINGS</h3>
						<p>Philosophy & Lore</p>
					</div>

				</div>

			</section>


			<!-- CREATIONS -->
			<section class="creations" id="creations">

				<div class="section-number">IV</div>

				<div class="section-label">
					CREATIVE WORKS
				</div>

				<h2>
					CREATIONS
				</h2>

				<div class="blood-divider"></div>

				<div class="creation-links">

					<a
						href="https://www.artstation.com/diosreyal"
						target="_blank"
						rel="noopener noreferrer"
					>
						<span>ART</span>
						<strong>ARTSTATION →</strong>
					</a>

					<a
						href="https://www.poeticous.com/alczolivier"
						target="_blank"
						rel="noopener noreferrer"
					>
						<span>POETRY</span>
						<strong>POETICOUS →</strong>
					</a>

					<a
						href="https://www.twitch.tv/diosreyal"
						target="_blank"
						rel="noopener noreferrer"
					>
						<span>STREAMING</span>
						<strong>TWITCH →</strong>
					</a>

				</div>

			</section>


			<!-- IMPORTANT LINKS -->
			<section class="links-section" id="links">

				<div class="section-number">V</div>

				<div class="section-label">
					THE KINGDOM ONLINE
				</div>

				<h2>
					IMPORTANT LINKS
				</h2>

				<div class="blood-divider"></div>

				<div class="link-list">

					<a
						href="https://allmylinks.com/divinoreinodedioreal"
						target="_blank"
						rel="noopener noreferrer"
					>
						All My Links
						<span>→</span>
					</a>

					<a
						href="https://www.twitch.tv/diosreyal"
						target="_blank"
						rel="noopener noreferrer"
					>
						Twitch
						<span>→</span>
					</a>

					<a
						href="https://www.artstation.com/diosreyal"
						target="_blank"
						rel="noopener noreferrer"
					>
						ArtStation
						<span>→</span>
					</a>

					<a
						href="https://www.poeticous.com/alczolivier"
						target="_blank"
						rel="noopener noreferrer"
					>
						Poeticous
						<span>→</span>
					</a>

				</div>

			</section>


			<!-- SUPPORT -->
			<section class="support">

				<div class="section-number">VI</div>

				<div class="section-label">
					SUPPORT THE KINGDOM
				</div>

				<h2>
					DONATIONS
				</h2>

				<div class="blood-divider"></div>

				<p>
					Support the development and continuation of the
					Divine Kingdom of Dio Re Al.
				</p>

				<a
					class="donate"
					href="https://www.paypal.com/donate/?cmd=_donations&source=url&business=kingdom_of_al@outlook.es"
					target="_blank"
					rel="noopener noreferrer"
				>
					DONATE TO THE CAUSE
				</a>

			</section>


			<!-- CONTACT -->
			<section class="contact" id="contact">

				<div class="section-number">VII</div>

				<div class="section-label">
					COMMUNICATION
				</div>

				<h2>
					CONTACT
				</h2>

				<div class="blood-divider"></div>

				<p>
					For official correspondence:
				</p>

				<a
					class="email"
					href="mailto:divinekingdomofal@proton.me"
				>
					divinekingdomofal@proton.me
				</a>

			</section>


			<!-- FINAL DECLARATION -->
			<section class="final-declaration">

				<div class="final-symbol">
					<img
						src="/dio-re-al-white-sun-of-dio-re-al-x-design.webp"
						alt="Dio Re Al White Sun"
					/>
				</div>

				<h2>
					DIO RE AL
				</h2>

				<p>
					ETERNAL · INVICTUS · IMMORTAL
				</p>

			</section>


			<!-- COPYRIGHT -->
			<footer class="kingdom-footer">

				<div class="footer-symbol">
					<img
						src="/dio-re-al-white-sun-of-dio-re-al-x-design.webp"
						alt="Dio Re Al"
					/>
				</div>

				<div class="footer-title">
					DIVINE KINGDOM OF DIO RE AL
				</div>

				<div class="footer-links">

					<a
						href="https://allmylinks.com/divinoreinodedioreal"
						target="_blank"
						rel="noopener noreferrer"
					>
						All My Links
					</a>

					<a
						href="https://www.twitch.tv/diosreyal"
						target="_blank"
						rel="noopener noreferrer"
					>
						Twitch
					</a>

					<a
						href="https://www.artstation.com/diosreyal"
						target="_blank"
						rel="noopener noreferrer"
					>
						ArtStation
					</a>

					<a
						href="https://www.poeticous.com/alczolivier"
						target="_blank"
						rel="noopener noreferrer"
					>
						Poeticous
					</a>

					<a href="mailto:divinekingdomofal@proton.me">
						Contact
					</a>

				</div>

				<div class="copyright">
					© The Divine Kingdom of Dio Re Al • All Rights Reserved.
				</div>

			</footer>

		</main>

	</body>
</html>


<style>

:global(*) {
	box-sizing: border-box;
}

:global(html) {
	scroll-behavior: smooth;
}

:global(body) {
	margin: 0;
	background: #050505;
	color: #e8e8e8;
	font-family: 'Inter', sans-serif;
}

:global(a) {
	color: inherit;
	text-decoration: none;
}


/* BACKGROUND */

.blood-glow {
	position: fixed;
	width: 500px;
	height: 500px;
	border-radius: 50%;
	background: rgba(110, 0, 0, 0.12);
	filter: blur(120px);
	top: 20%;
	right: 10%;
	pointer-events: none;
	z-index: -1;
}


/* SIDEBAR */

.sidebar {
	position: fixed;
	left: 0;
	top: 0;
	width: 270px;
	height: 100vh;
	padding: 45px 35px;
	background: #030303;
	border-right: 1px solid #3c0808;
	text-align: center;
	z-index: 100;
	overflow-y: auto;
}

.solar-symbol {
	display: flex;
	justify-content: center;
	align-items: center;
	margin-bottom: 20px;
}

.solar-symbol img {
	width: 120px;
	height: 120px;
	object-fit: contain;
	display: block;
	filter: drop-shadow(0 0 18px rgba(180, 0, 0, 0.45));
}

.kingdom-title {
	font-family: 'Cinzel', serif;
	font-size: 18px;
	line-height: 1.35;
	letter-spacing: 4px;
	color: white;
}

.of-text {
	font-size: 9px;
	letter-spacing: 5px;
	margin: 12px 0;
	color: #777;
}

.dio-title {
	font-family: 'Cinzel', serif;
	font-size: 20px;
	font-weight: 700;
	letter-spacing: 3px;
	color: #d00000;
}

.red-line {
	height: 1px;
	background: linear-gradient(
		to right,
		transparent,
		#8b0000,
		transparent
	);
	margin: 30px 0;
}

.sidebar-description {
	font-size: 11px;
	line-height: 1.8;
	color: #777;
}

.navigation {
	display: flex;
	flex-direction: column;
	margin-top: 35px;
	text-align: left;
}

.navigation a {
	display: flex;
	gap: 15px;
	padding: 12px 0;
	border-bottom: 1px solid #151515;
	color: #888;
	font-size: 11px;
	letter-spacing: 2px;
	transition: .3s;
}

.navigation a span {
	color: #500000;
	font-size: 9px;
}

.navigation a:hover {
	color: #e00000;
	padding-left: 6px;
}

.sidebar-social {
	display: flex;
	flex-direction: column;
	gap: 12px;
	margin-top: 35px;
	font-size: 10px;
	letter-spacing: 2px;
	color: #666;
}

.sidebar-social a:hover {
	color: white;
}

.sidebar-bottom {
	position: absolute;
	bottom: 20px;
	left: 0;
	width: 100%;
	display: flex;
	justify-content: center;
}

.sidebar-bottom img {
	width: 28px;
	height: 28px;
	object-fit: contain;
	opacity: .45;
}


/* MOBILE HEADER */

.mobile-header {
	display: none;
}


/* MAIN */

.content {
	margin-left: 270px;
	max-width: 1200px;
}


/* HERO */

.hero {
	min-height: 100vh;
	display: flex;
	flex-direction: column;
	justify-content: center;
	padding: 100px 10%;
	border-bottom: 1px solid #210505;
}

.hero-small {
	color: #8b0000;
	font-size: 10px;
	letter-spacing: 5px;
	margin-bottom: 25px;
}

.hero h1 {
	font-family: 'Cinzel', serif;
	font-size: clamp(42px, 7vw, 90px);
	line-height: 1.05;
	font-weight: 500;
	letter-spacing: 4px;
	margin: 0;
	color: white;
}

.hero h1 span {
	display: block;
	color: #b00000;
}

.hero-line {
	width: 160px;
	height: 1px;
	background: #850000;
	margin: 40px 0 25px;
}

.hero p {
	font-size: 10px;
	letter-spacing: 6px;
	color: #777;
}


/* SECTIONS */

.introduction,
.philosophy,
.lore,
.creations,
.links-section,
.support,
.contact {
	max-width: 850px;
	margin: auto;
	padding: 130px 50px;
}

.section-number {
	font-family: 'Cinzel', serif;
	color: #600000;
	font-size: 14px;
	letter-spacing: 4px;
	margin-bottom: 15px;
}

.section-label {
	font-size: 9px;
	letter-spacing: 5px;
	color: #777;
	margin-bottom: 20px;
}

h2 {
	font-family: 'Cinzel', serif;
	font-weight: 500;
	letter-spacing: 4px;
	color: white;
}

.introduction h2,
.philosophy h2,
.lore h2,
.creations h2,
.links-section h2,
.support h2,
.contact h2 {
	font-size: clamp(30px, 5vw, 55px);
	margin: 0;
}

.blood-divider {
	width: 100px;
	height: 1px;
	background: #8b0000;
	margin: 30px 0;
}

.introduction p,
.philosophy p,
.lore p,
.support p,
.contact p {
	color: #aaa;
	line-height: 2;
	font-size: 15px;
}

.large-text {
	font-family: 'Cinzel', serif;
	font-size: 22px !important;
	line-height: 1.8 !important;
	color: #ddd !important;
}

.large-text strong {
	color: #c00000;
}


/* POSTS */

.posts {
	max-width: 850px;
	margin: auto;
}

.post {
	position: relative;
	padding: 100px 50px;
	border-top: 1px solid #210505;
}

.post-number {
	color: #600000;
	font-family: 'Cinzel', serif;
	font-size: 12px;
	letter-spacing: 4px;
}

.post-date {
	margin-top: 10px;
	color: #666;
	font-size: 9px;
	letter-spacing: 3px;
	text-transform: uppercase;
}

.post h2 {
	font-size: 30px;
	margin: 20px 0;
}

.post-line {
	width: 60px;
	height: 1px;
	background: #800000;
	margin-bottom: 30px;
}

.post-content {
	color: #aaa;
	font-size: 15px;
	line-height: 2;
}

.post-content strong {
	color: white;
}

.post-content blockquote {
	margin: 30px 0;
	padding: 25px 30px;
	border-left: 2px solid #900000;
	background: rgba(80, 0, 0, .08);
	font-family: 'Cinzel', serif;
	font-size: 20px;
	line-height: 1.8;
	color: #ddd;
}

.quote-author {
	color: #850000 !important;
	text-align: right;
	font-size: 10px !important;
	letter-spacing: 3px;
}


/* PHILOSOPHY */

.alternate-name {
	font-size: 9px;
	letter-spacing: 4px;
	color: #700000;
}

.principle-box {
	display: flex;
	gap: 30px;
	margin-top: 60px;
	padding: 35px;
	border: 1px solid #350808;
	background: #080404;
}

.principle-symbol {
	font-size: 40px;
	color: #a00000;
}

.principle-title {
	font-family: 'Cinzel', serif;
	font-size: 18px;
	letter-spacing: 3px;
}

.principle-box p {
	margin: 15px 0;
}

.principle-box span {
	font-size: 9px;
	letter-spacing: 3px;
	color: #800000;
}


/* LORE */

.lore-grid {
	display: grid;
	grid-template-columns: repeat(3, 1fr);
	gap: 15px;
	margin-top: 50px;
}

.lore-card {
	border: 1px solid #2b0707;
	padding: 30px 20px;
	background: #080808;
	transition: .3s;
}

.lore-card:hover {
	border-color: #800000;
	transform: translateY(-4px);
}

.lore-card span {
	color: #650000;
	font-size: 10px;
}

.lore-card h3 {
	font-family: 'Cinzel', serif;
	font-size: 14px;
	letter-spacing: 2px;
}

.lore-card p {
	font-size: 11px;
	margin: 0;
}


/* CREATIONS */

.creation-links {
	display: flex;
	flex-direction: column;
}

.creation-links a {
	display: flex;
	justify-content: space-between;
	padding: 25px 0;
	border-bottom: 1px solid #220505;
	color: #888;
	transition: .3s;
