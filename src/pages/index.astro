---
import BaseHead from '../components/BaseHead.astro';

const SITE_TITLE = 'Divine Kingdom of Dio Re Al';
const SITE_DESCRIPTION =
	'The official domain of the Divine Kingdom of Dio Re Al — Alipseism / Diorealism.';

const whiteSun = '/dio-re-al-white-sun-of-dio-re-al-x-design.webp';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

		<link
			href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600;700;800;900&family=Inter:wght@300;400;500;600&display=swap"
			rel="stylesheet"
		/>
	</head>

	<body>

		<!-- AMBIENT LIGHT -->
		<div class="ambient ambient-one"></div>
		<div class="ambient ambient-two"></div>

		<!-- NAVIGATION -->
		<header class="navigation">

			<a href="#top" class="brand">
				<img src={whiteSun} alt="Dio Re Al symbol" />
				<span>DIO RE AL</span>
			</a>

			<nav>
				<a href="#kingdom">KINGDOM</a>
				<a href="#philosophy">PHILOSOPHY</a>
				<a href="#lore">LORE</a>
				<a href="#creations">CREATIONS</a>
				<a href="#contact">CONTACT</a>
			</nav>

			<a
				class="nav-button"
				href="https://allmylinks.com/divinoreinodedioreal"
				target="_blank"
				rel="noopener noreferrer"
			>
				ENTER
			</a>

		</header>


		<main id="top">

			<!-- ================================================= -->
			<!-- HERO -->
			<!-- ================================================= -->

			<section class="hero">

				<div class="hero-background-symbol">
					<img src={whiteSun} alt="" />
				</div>

				<div class="hero-content">

					<div class="eyebrow">
						THE OFFICIAL DOMAIN
					</div>

					<div class="hero-symbol">
						<img src={whiteSun} alt="Dio Re Al White Sun" />
					</div>

					<h1>
						DIO
						<span>RE AL</span>
					</h1>

					<div class="hero-rule">
						<span></span>
						☉
						<span></span>
					</div>

					<h2>
						DIVINE KINGDOM
					</h2>

					<p class="motto">
						ETERNAL · INVICTUS · IMMORTAL
					</p>

					<a class="hero-button" href="#kingdom">
						ENTER THE KINGDOM
						<span>↓</span>
					</a>

				</div>

				<div class="scroll-indicator">
					<span>SCROLL</span>
					<div></div>
				</div>

			</section>


			<!-- ================================================= -->
			<!-- DECLARATION -->
			<!-- ================================================= -->

			<section class="declaration">

				<div class="section-marker">
					01
					<span></span>
					THE DECLARATION
				</div>

				<div class="declaration-grid">

					<div class="declaration-title">
						<p>THE VOICE OF</p>

						<h2>
							LORD<br />
							AL
						</h2>
					</div>

					<div class="declaration-text">

						<div class="quote-mark">“</div>

						<blockquote>
							I am Lord Al, Dio Re Al...
							The Only Real Eternal Invictus
							Immortal God King of All.
						</blockquote>

						<div class="quote-author">
							— DIO RE AL
						</div>

						<p>
							The Divine Kingdom of Dio Re Al is the official
							domain for the writings, philosophy, creations,
							lore and works of Dio Re Al.
						</p>

					</div>

				</div>

			</section>


			<!-- ================================================= -->
			<!-- KINGDOM -->
			<!-- ================================================= -->

			<section class="kingdom" id="kingdom">

				<div class="section-marker">
					02
					<span></span>
					THE KINGDOM
				</div>

				<div class="kingdom-heading">

					<p>WELCOME TO</p>

					<h2>
						THE DIVINE
						<span>KINGDOM</span>
					</h2>

				</div>

				<div class="kingdom-introduction">

					<p class="lead">
						A kingdom of thought, creation, symbolism,
						writing and expression.
					</p>

					<p>
						Explore the world of Dio Re Al through its philosophy,
						writings, lore, artwork, poetry, music and other
						creative works.
					</p>

				</div>


				<div class="kingdom-grid">

					<a href="#philosophy" class="kingdom-card">

						<div class="card-number">I</div>

						<div class="card-symbol">☉</div>

						<h3>
							ALIPSEISM
						</h3>

						<p>
							Religion · Philosophy · Lifestyle
						</p>

						<span class="card-arrow">→</span>

					</a>


					<a href="#lore" class="kingdom-card">

						<div class="card-number">II</div>

						<div class="card-symbol">✦</div>

						<h3>
							LORE
						</h3>

						<p>
							History · Characters · Kingdoms
						</p>

						<span class="card-arrow">→</span>

					</a>


					<a href="#creations" class="kingdom-card">

						<div class="card-number">III</div>

						<div class="card-symbol">◇</div>

						<h3>
							CREATIONS
						</h3>

						<p>
							Art · Poetry · Music · Streaming
						</p>

						<span class="card-arrow">→</span>

					</a>

				</div>

			</section>


			<!-- ================================================= -->
			<!-- PHILOSOPHY -->
			<!-- ================================================= -->

			<section class="philosophy" id="philosophy">

				<div class="section-marker">
					03
					<span></span>
					THE PHILOSOPHY
				</div>

				<div class="philosophy-layout">

					<div>

						<p class="small-heading">
							ALIPSEISM / DIOREALISM
						</p>

						<h2>
							THE<br />
							SELF
						</h2>

					</div>


					<div class="philosophy-main">

						<p class="philosophy-lead">
							Alipseism or Diorealism is my religion,
							philosophy and lifestyle.
						</p>

						<p>
							I am the Leader, Creator, King, God, Founder
							and Owner of it.
						</p>

						<div class="philosophy-quote">

							<div class="quote-symbol">
								☉
							</div>

							<div>

								<blockquote>
									“Selflessness does not exist.
									You can't be selfless without
									a self in the first place.”
								</blockquote>

								<div class="quote-author">
									— DIO RE AL
								</div>

							</div>

						</div>

					</div>

				</div>

			</section>


			<!-- ================================================= -->
			<!-- LORE -->
			<!-- ================================================= -->

			<section class="lore" id="lore">

				<div class="section-marker">
					04
					<span></span>
					THE WRITINGS
				</div>

				<div class="lore-header">

					<div>

						<p class="small-heading">
							THE ARCHIVES
						</p>

						<h2>
							LORE
						</h2>

					</div>

					<p>
						Discover the writings, concepts, symbols,
						characters and worlds belonging to the
						Divine Kingdom.
					</p>

				</div>


				<div class="archive">

					<div class="archive-row">
						<span>01</span>
						<strong>THE KINGDOM</strong>
						<em>ARCHIVE</em>
					</div>

					<div class="archive-row">
						<span>02</span>
						<strong>THE FOUNDATIONS</strong>
						<em>PHILOSOPHY</em>
					</div>

					<div class="archive-row">
						<span>03</span>
						<strong>THE SYMBOLS</strong>
						<em>SYMBOLISM</em>
					</div>

					<div class="archive-row">
						<span>04</span>
						<strong>THE CHARACTERS</strong>
						<em>LORE</em>
					</div>

					<div class="archive-row">
						<span>05</span>
						<strong>THE WRITINGS</strong>
						<em>TEXTS</em>
					</div>

				</div>

			</section>


			<!-- ================================================= -->
			<!-- CREATIONS -->
			<!-- ================================================= -->

			<section class="creations" id="creations">

				<div class="section-marker">
					05
					<span></span>
					CREATIVE WORKS
				</div>

				<div class="creations-heading">

					<p class="small-heading">
						THE WORKS OF DIO RE AL
					</p>

					<h2>
						CREATE.
						<span>EXPRESS.</span>
					</h2>

				</div>


				<div class="creation-grid">

					<a
						href="https://www.artstation.com/diosreyal"
						target="_blank"
						rel="noopener noreferrer"
						class="creation-card"
					>

						<div class="creation-top">
							01
							<span>↗</span>
						</div>

						<div class="creation-icon">◇</div>

						<h3>
							ARTSTATION
						</h3>

						<p>
							Visual art and artistic creations.
						</p>

					</a>


					<a
						href="https://www.poeticous.com/alczolivier"
						target="_blank"
						rel="noopener noreferrer"
						class="creation-card"
					>

						<div class="creation-top">
							02
							<span>↗</span>
						</div>

						<div class="creation-icon">“</div>

						<h3>
							POETICOUS
						</h3>

						<p>
							Poetry and written expression.
						</p>

					</a>


					<a
						href="https://www.twitch.tv/diosreyal"
						target="_blank"
						rel="noopener noreferrer"
						class="creation-card"
					>

						<div class="creation-top">
							03
							<span>↗</span>
						</div>

						<div class="creation-icon">●</div>

						<h3>
							TWITCH
						</h3>

						<p>
							Live streams and broadcasts.
						</p>

					</a>

				</div>

			</section>


			<!-- ================================================= -->
			<!-- NETWORK -->
			<!-- ================================================= -->

			<section class="network">

				<div class="section-marker">
					06
					<span></span>
					THE NETWORK
				</div>

				<h2>
					FIND THE<br />
					KINGDOM
				</h2>

				<div class="network-links">

					<a
						href="https://allmylinks.com/divinoreinodedioreal"
						target="_blank"
						rel="noopener noreferrer"
					>
						<span>01</span>
						<strong>ALL MY LINKS</strong>
						<em>→</em>
					</a>

					<a
						href="https://www.artstation.com/diosreyal"
						target="_blank"
						rel="noopener noreferrer"
					>
						<span>02</span>
						<strong>ARTSTATION</strong>
						<em>→</em>
					</a>

					<a
						href="https://www.poeticous.com/alczolivier"
						target="_blank"
						rel="noopener noreferrer"
					>
						<span>03</span>
						<strong>POETICOUS</strong>
						<em>→</em>
					</a>

					<a
						href="https://www.twitch.tv/diosreyal"
						target="_blank"
						rel="noopener noreferrer"
					>
						<span>04</span>
						<strong>TWITCH</strong>
						<em>→</em>
					</a>

				</div>

			</section>


			<!-- ================================================= -->
			<!-- SUPPORT -->
			<!-- ================================================= -->

			<section class="support">

				<div class="support-symbol">
					<img src={whiteSun} alt="Dio Re Al symbol" />
				</div>

				<p class="small-heading">
					SUPPORT THE KINGDOM
				</p>

				<h2>
					CONTRIBUTE
				</h2>

				<p>
					Support the continuation and development of
					the Divine Kingdom of Dio Re Al.
				</p>

				<a
					class="support-button"
					href="https://www.paypal.com/donate/?cmd=_donations&source=url&business=kingdom_of_al@outlook.es"
					target="_blank"
					rel="noopener noreferrer"
				>
					SUPPORT THE CAUSE
					<span>→</span>
				</a>

			</section>


			<!-- ================================================= -->
			<!-- CONTACT -->
			<!-- ================================================= -->

			<section class="contact" id="contact">

				<div class="section-marker">
					07
					<span></span>
					COMMUNICATION
				</div>

				<div class="contact-layout">

					<div>

						<p class="small-heading">
							OFFICIAL CORRESPONDENCE
						</p>

						<h2>
							CONTACT
						</h2>

					</div>

					<div>

						<p>
							For official correspondence with the
							Divine Kingdom of Dio Re Al:
						</p>

						<a
							class="contact-email"
							href="mailto:divinekingdomofal@proton.me"
						>
							divinekingdomofal@proton.me
						</a>

					</div>

				</div>

			</section>


			<!-- ================================================= -->
			<!-- FINAL SEAL -->
			<!-- ================================================= -->

			<section class="final-seal">

				<div class="seal-line"></div>

				<img
					src={whiteSun}
					alt="Dio Re Al White Sun"
				/>

				<h2>
					DIO RE AL
				</h2>

				<p>
					DIVINE KINGDOM
				</p>

				<div class="seal-line"></div>

			</section>


			<!-- ================================================= -->
			<!-- FOOTER -->
			<!-- ================================================= -->

			<footer>

				<div class="footer-main">

					<div class="footer-brand">

						<img src={whiteSun} alt="Dio Re Al" />

						<div>
							<strong>
								DIVINE KINGDOM
							</strong>

							<span>
								OF DIO RE AL
							</span>
						</div>

					</div>


					<div class="footer-navigation">

						<a href="#top">Home</a>
						<a href="#kingdom">Kingdom</a>
						<a href="#philosophy">Philosophy</a>
						<a href="#lore">Lore</a>
						<a href="#creations">Creations</a>
						<a href="#contact">Contact</a>

					</div>


					<div class="footer-social">

						<a
							href="https://allmylinks.com/divinoreinodedioreal"
							target="_blank"
							rel="noopener noreferrer"
						>
							All My Links
						</a>

						<a
							href="https://www.twitch.tv/diosreyal"
							target="_blank"
							rel="noopener noreferrer"
						>
							Twitch
						</a>

						<a
							href="https://www.artstation.com/diosreyal"
							target="_blank"
							rel="noopener noreferrer"
						>
							ArtStation
						</a>

						<a
							href="https://www.poeticous.com/alczolivier"
							target="_blank"
							rel="noopener noreferrer"
						>
							Poeticous
						</a>

					</div>

				</div>


				<div class="footer-bottom">

					<span>
						© The Divine Kingdom of Dio Re Al • All Rights Reserved.
					</span>

					<a href="mailto:divinekingdomofal@proton.me">
						divinekingdomofal@proton.me
					</a>

				</div>

			</footer>

		</main>

	</body>
</html>


<style>

:global(*) {
	box-sizing: border-box;
}

:global(html) {
	scroll-behavior: smooth;
}

:global(body) {
	margin: 0;
	background: #050505;
	color: #eeeeee;
	font-family: 'Inter', sans-serif;
	overflow-x: hidden;
}

:global(a) {
	color: inherit;
	text-decoration: none;
}


/* =========================================================
   AMBIENT BACKGROUND
========================================================= */

.ambient {
	position: fixed;
	border-radius: 50%;
	filter: blur(140px);
	pointer-events: none;
	z-index: -2;
}

.ambient-one {
	width: 500px;
	height: 500px;
	background: rgba(130, 0, 0, .13);
	top: 10%;
	right: -200px;
}

.ambient-two {
	width: 350px;
	height: 350px;
	background: rgba(100, 0, 0, .08);
	bottom: 10%;
	left: 10%;
}


/* =========================================================
   NAVIGATION
========================================================= */

.navigation {
	position: fixed;
	top: 0;
	left: 0;
	right: 0;
	height: 80px;

	display: grid;
	grid-template-columns: 1fr auto 1fr;
	align-items: center;

	padding: 0 45px;

	background: rgba(5,5,5,.88);
	border-bottom: 1px solid #250707;

	backdrop-filter: blur(15px);

	z-index: 1000;
}

.brand {
	display: flex;
	align-items: center;
	gap: 12px;

	font-family: 'Cinzel', serif;
	font-size: 12px;
	letter-spacing: 3px;
}

.brand img {
	width: 32px;
	height: 32px;
	object-fit: contain;
}

.navigation nav {
	display: flex;
	gap: 35px;
}

.navigation nav a {
	font-size: 9px;
	letter-spacing: 2px;
	color: #777;
	transition: .3s;
}

.navigation nav a:hover {
	color: #d00000;
}

.nav-button {
	justify-self: end;

	border: 1px solid #650000;

	padding: 10px 20px;

	font-size: 8px;
	letter-spacing: 3px;

	color: #b00000;

	transition: .3s;
}

.nav-button:hover {
	background: #700000;
	color: white;
}


/* =========================================================
   HERO
========================================================= */

.hero {
	position: relative;

	min-height: 100vh;

	display: flex;
	align-items: center;
	justify-content: center;

	text-align: center;

	overflow: hidden;

	border-bottom: 1px solid #240606;
}

.hero-background-symbol {
	position: absolute;

	width: 700px;
	height: 700px;

	opacity: .025;

	animation: slowRotate 60s linear infinite;
}

.hero-background-symbol img {
	width: 100%;
	height: 100%;
	object-fit: contain;
}

@keyframes slowRotate {
	from {
		transform: rotate(0deg);
	}
	to {
		transform: rotate(360deg);
	}
}

.hero-content {
	position: relative;
	z-index: 2;
}

.eyebrow {
	color: #8b0000;
	font-size: 9px;
	letter-spacing: 7px;
	margin-bottom: 35px;
}

.hero-symbol img {
	width: 155px;
	height: 155px;
	object-fit: contain;

	filter:
		drop-shadow(0 0 20px rgba(255,255,255,.12))
		drop-shadow(0 0 40px rgba(120,0,0,.25));

	animation: symbolPulse 5s ease-in-out infinite;
}

@keyframes symbolPulse {
	0%,100% {
		filter:
			drop-shadow(0 0 20px rgba(255,255,255,.10))
			drop-shadow(0 0 40px rgba(120,0,0,.20));
	}

	50% {
		filter:
			drop-shadow(0 0 30px rgba(255,255,255,.18))
			drop-shadow(0 0 60px rgba(150,0,0,.30));
	}
}

.hero h1 {
	font-family: 'Cinzel', serif;
	font-weight: 500;

	font-size: clamp(55px, 10vw, 140px);

	line-height: .85;

	letter-spacing: 12px;

	margin: 30px 0 25px;

	color: #fff;
}

.hero h1 span {
	color: #a80000;
}

.hero-rule {
	display: flex;
	align-items: center;
	justify-content: center;
	gap: 18px;

	color: #8b0000;

	font-size: 15px;
}

.hero-rule span {
	width: 100px;
	height: 1px;
	background: linear-gradient(
		to right,
		transparent,
		#700000
	);
}

.hero-rule span:last-child {
	background: linear-gradient(
		to left,
		transparent,
		#700000
	);
}

.hero h2 {
	font-family: 'Cinzel', serif;
	font-size: 16px;
	font-weight: 400;

	letter-spacing: 8px;

	margin: 25px 0 15px;
}

.motto {
	font-size: 8px;
	letter-spacing: 6px;
	color: #666;
}

.hero-button {
	display: inline-flex;
	align-items: center;
	gap: 30px;

	margin-top: 50px;

	border: 1px solid #650000;

	padding: 17px 25px;

	font-size: 8px;
	letter-spacing: 3px;

	color: #bbb;

	transition: .4s;
}

.hero-button span {
	color: #900000;
	font-size: 16px;
}

.hero-button:hover {
	background: #700000;
	color: white;
}

.scroll-indicator {
	position: absolute;

	bottom: 35px;
	left: 50%;

	transform: translateX(-50%);

	display: flex;
	flex-direction: column;
	align-items: center;
	gap: 12px;

	color: #444;

	font-size: 7px;
	letter-spacing: 4px;
}

.scroll-indicator div {
	width: 1px;
	height: 35px;
	background: linear-gradient(
		#700000,
		transparent
	);
}


/* =========================================================
   GLOBAL SECTION
========================================================= */

section:not(.hero) {
	border-bottom: 1px solid #180404;
}

.section-marker {
	display: flex;
	align-items: center;
	gap: 15px;

	font-size: 8px;
	letter-spacing: 4px;

	color: #650000;
	margin-bottom: 70px;
}

.section-marker span {
	width: 70px;
	height: 1px;
	background: #450000;
}

.small-heading {
	font-size: 8px;
	letter-spacing: 5px;
	color: #700000;
}


/* =========================================================
   DECLARATION
========================================================= */

.declaration {
	padding: 150px 9%;
}

.declaration-grid {
	max-width: 1100px;
	margin: auto;

	display: grid;
	grid-template-columns: 35% 65%;

	gap: 80px;
}

.declaration-title p {
	font-size: 8px;
	letter-spacing: 5px;
	color: #555;
}

.declaration-title h2 {
	font-family: 'Cinzel', serif;

	font-size: clamp(50px, 7vw, 100px);

	font-weight: 400;

	line-height: .85;

	margin: 20px 0;

	letter-spacing: 5px;
}

.declaration-text {
	position: relative;
}

.quote-mark {
	font-family: Georgia, serif;

	font-size: 120px;

	color: #450000;

	line-height: .5;

	margin-bottom: 30px;
}

.declaration blockquote {
	font-family: 'Cinzel', serif;

	font-size: clamp(24px, 3vw, 38px);

	line-height: 1.6;

	color: #ddd;

	margin: 0;

