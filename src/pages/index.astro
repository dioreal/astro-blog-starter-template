--- import BaseHead from '../components/BaseHead.astro'; import Header from '../components/Header.astro'; import Footer from '../components/Footer.astro'; import { SITE_TITLE, SITE_DESCRIPTION } from '../consts'; --- <!doctype html> <html lang="en"> <head> <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} /> </head> <body> <Header /> <main> <section class="hero"> <div class="blood-glow"></div> <div class="solar-symbol">☉</div> <div class="hero-content"> <p class="eyebrow">THE DIVINE KINGDOM</p> <h1>DIO RE AL</h1> <p class="subtitle">DIVINE KINGDOM OF DIO RE AL</p> <div class="divider"></div> <p class="intro"> A kingdom of self-divinity, creation, freedom, passion, immortality and the pursuit of the eternal. </p> <div class="hero-actions"> <a href="#kingdom" class="primary-button"> ENTER THE KINGDOM </a> <a href="#lore" class="secondary-button"> DISCOVER THE LORE </a> </div> </div> </section> <section id="kingdom" class="section"> <div class="section-heading"> <p class="eyebrow">THE REALM</p> <h2>DIVINE KINGDOM</h2> <div class="small-divider"></div> </div> <div class="content-grid"> <article class="card"> <span class="card-symbol">☉</span> <h3>The Kingdom</h3> <p> Explore the Divine Kingdom of Dio Re Al, its realms, symbols, mythology and vision. </p> <a href="/kingdom/">ENTER →</a> </article> <article class="card"> <span class="card-symbol">Λ</span> <h3>Ælipseism</h3> <p> Discover the philosophy, principles and foundations of Ælipseism. </p> <a href="/alipseism/">DISCOVER →</a> </article> <article class="card"> <span class="card-symbol">♔</span> <h3>The Pantheon</h3> <p> Meet the divine beings, goddesses and inhabitants of the Kingdom. </p> <a href="/pantheon/">EXPLORE →</a> </article> </div> </section> <section id="lore" class="lore-section"> <div class="lore-content"> <p class="eyebrow">THE CHRONICLES</p> <h2>A KINGDOM BEYOND MORTALITY</h2> <div class="small-divider"></div> <p> The Divine Kingdom of Dio Re Al is a world of mythology, philosophy, art and creation. A universe built around the pursuit of freedom, individuality, passion and the eternal. </p> <p> Enter the chronicles and discover its mythology, its kingdoms, its divine beings and the worlds that exist beyond the mortal realm. </p> <a href="/lore/" class="primary-button"> READ THE CHRONICLES </a> </div> </section> <section class="manifesto"> <p class="eyebrow">THE CREATION</p> <blockquote> "Create your world. Become your own divinity." </blockquote> <p class="signature">— DIO RE AL</p> </section> </main> <Footer /> </body> </html> <style> :global(html) { scroll-behavior: smooth; } :global(body) { margin: 0; background: radial-gradient( circle at 50% 0%, #3a0808 0%, #0b0202 35%, #020202 75%, #000000 100% ); color: #ffffff; font-family: Georgia, 'Times New Roman', serif; } main { overflow: hidden; } .hero { min-height: 92vh; display: flex; align-items: center; justify-content: center; position: relative; text-align: center; padding: 80px 24px; box-sizing: border-box; background: radial-gradient( circle at center, rgba(130, 0, 0, 0.12), transparent 55% ); } .blood-glow { position: absolute; width: 600px; height: 600px; border-radius: 50%; background: radial-gradient( circle, rgba(210, 0, 0, 0.22), rgba(120, 0, 0, 0.08) 35%, transparent 70% ); filter: blur(25px); animation: pulse 6s ease-in-out infinite; } .solar-symbol { position: absolute; font-size: 22rem; line-height: 1; color: rgba(255, 255, 255, 0.025); user-select: none; pointer-events: none; } .hero-content { position: relative; max-width: 1000px; z-index: 1; } .eyebrow { letter-spacing: 0.4em; font-size: 0.72rem; color: #d00000; margin-bottom: 25px; text-transform: uppercase; } h1 { font-size: clamp(4.5rem, 13vw, 10rem); letter-spacing: 0.08em; margin: 0; line-height: 0.9; font-weight: 400; color: #ffffff; text-shadow: 0 0 15px rgba(255, 255, 255, 0.12), 0 0 50px rgba(180, 0, 0, 0.25); } .subtitle { font-size: clamp(0.9rem, 2vw, 1.25rem); letter-spacing: 0.42em; margin: 32px 0; color: #eeeeee; } .divider, .small-divider { width: 100px; height: 1px; background: linear-gradient( to right, transparent, #d00000, transparent ); margin: 28px auto; } .intro { max-width: 650px; margin: 0 auto 40px; line-height: 1.9; font-size: 1.08rem; color: #b8b0b0; } .hero-actions { display: flex; gap: 16px; justify-content: center; flex-wrap: wrap; } .primary-button, .secondary-button { display: inline-block; padding: 15px 28px; text-decoration: none; letter-spacing: 0.13em; font-size: 0.75rem; transition: 0.25s ease; } .primary-button { background: #ffffff; color: #080000; } .primary-button:hover { background: #d00000; color: #ffffff; transform: translateY(-3px); box-shadow: 0 0 30px rgba(210, 0, 0, 0.35); } .secondary-button { border: 1px solid #5a2525; color: #ffffff; background: rgba(20, 0, 0, 0.25); } .secondary-button:hover { border-color: #d00000; color: #ff3333; } .section, .manifesto { max-width: 1200px; margin: 0 auto; padding: 130px 24px; } .section-heading { text-align: center; margin-bottom: 65px; } h2 { font-size: clamp(2rem, 5vw, 4rem); font-weight: 400; letter-spacing: 0.08em; margin: 0; color: #ffffff; } .content-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; } .card { padding: 40px; border: 1px solid #321010; background: linear-gradient( 145deg, rgba(35, 5, 5, 0.8), rgba(8, 2, 2, 0.9) ); transition: 0.3s ease; position: relative; } .card::before { content: ''; position: absolute; top: 0; left: 0; width: 35px; height: 1px; background: #d00000; } .card:hover { transform: translateY(-6px); border-color: #8f1111; box-shadow: 0 15px 40px rgba(120, 0, 0, 0.15); } .card-symbol { font-size: 2.5rem; color: #d00000; } .card h3 { font-size: 1.5rem; font-weight: 400; margin: 20px 0 12px; color: #ffffff; } .card p { color: #a9a0a0; line-height: 1.75; } .card a { display: inline-block; margin-top: 15px; color: #ff3333; text-decoration: none; font-size: 0.75rem; letter-spacing: 0.13em; } .card a:hover { color: #ffffff; } .lore-section { max-width: none; background: linear-gradient( rgba(35, 0, 0, 0.65), rgba(10, 0, 0, 0.8) ); border-top: 1px solid #250707; border-bottom: 1px solid #250707; text-align: center; padding: 140px 24px; } .lore-content { max-width: 780px; margin: auto; } .lore-content p:not(.eyebrow) { color: #b8b0b0; line-height: 1.9; font-size: 1.05rem; } .lore-content .primary-button { margin-top: 25px; } .manifesto { text-align: center; padding-top: 160px; padding-bottom: 160px; } blockquote { font-size: clamp(1.8rem, 4vw, 3.5rem); line-height: 1.3; font-style: italic; font-weight: 400; max-width: 900px; margin: 20px auto; color: #ffffff; } .signature { color: #d00000; letter-spacing: 0.25em; font-size: 0.8rem; } @keyframes pulse { 0%, 100% { transform: scale(0.95); opacity: 0.7; } 50% { transform: scale(1.05); opacity: 1; } } @media (max-width: 800px) { .content-grid { grid-template-columns: 1fr; } .hero { min-height: 85vh; } .subtitle { letter-spacing: 0.2em; } .solar-symbol { font-size: 12rem; } .card { padding: 30px; } } </style>
