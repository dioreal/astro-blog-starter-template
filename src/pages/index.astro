```astro
---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>

	<body>
		<Header />

		<main>
			<section class="hero">
				<div class="hero-glow"></div>

				<div class="hero-content">
					<p class="eyebrow">THE DIVINE KINGDOM</p>

					<h1>
						DIO RE AL
					</h1>

					<p class="subtitle">
						DIVINE KINGDOM OF DIO RE AL
					</p>

					<p class="intro">
						A kingdom of self-divinity, creation, freedom, passion,
						immortality and the pursuit of the eternal.
					</p>

					<div class="hero-actions">
						<a href="#kingdom" class="primary-button">
							ENTER THE KINGDOM
						</a>

						<a href="#lore" class="secondary-button">
							DISCOVER THE LORE
						</a>
					</div>
				</div>
			</section>

			<section id="kingdom" class="section">
				<div class="section-heading">
					<p class="eyebrow">THE REALM</p>
					<h2>DIVINE KINGDOM</h2>
				</div>

				<div class="content-grid">
					<article class="card">
						<span class="card-symbol">☉</span>
						<h3>The Kingdom</h3>
						<p>
							Explore the Divine Kingdom of Dio Re Al,
							its realms, symbols, mythology and vision.
						</p>
						<a href="/kingdom/">ENTER →</a>
					</article>

					<article class="card">
						<span class="card-symbol">Λ</span>
						<h3>Ælipseism</h3>
						<p>
							Discover the philosophy, principles and foundations
							of Ælipseism.
						</p>
						<a href="/alipseism/">DISCOVER →</a>
					</article>

					<article class="card">
						<span class="card-symbol">♔</span>
						<h3>The Pantheon</h3>
						<p>
							Meet the divine beings, goddesses and inhabitants
							of the Kingdom.
						</p>
						<a href="/pantheon/">EXPLORE →</a>
					</article>
				</div>
			</section>

			<section id="lore" class="lore-section">
				<div class="lore-content">
					<p class="eyebrow">THE CHRONICLES</p>

					<h2>A KINGDOM BEYOND MORTALITY</h2>

					<p>
						The Divine Kingdom of Dio Re Al is a world of mythology,
						philosophy, art and creation. A universe built around
						the pursuit of freedom, individuality, passion and
						the eternal.
					</p>

					<p>
						Enter the chronicles and discover its mythology,
						its kingdoms, its divine beings and the worlds
						that exist beyond the mortal realm.
					</p>

					<a href="/lore/" class="primary-button">
						READ THE CHRONICLES
					</a>
				</div>
			</section>

			<section class="manifesto">
				<p class="eyebrow">THE CREATION</p>

				<blockquote>
					"Create your world. Become your own divinity."
				</blockquote>

				<p class="signature">— DIO RE AL</p>
			</section>
		</main>

		<Footer />
	</body>
</html>

<style>
	:global(html) {
		scroll-behavior: smooth;
	}

	:global(body) {
		margin: 0;
		background:
			radial-gradient(circle at 50% 0%, #26152f 0%, #09070d 38%, #030305 100%);
		color: #eee8f2;
		font-family: Georgia, 'Times New Roman', serif;
	}

	main {
		overflow: hidden;
	}

	.hero {
		min-height: 88vh;
		display: flex;
		align-items: center;
		justify-content: center;
		position: relative;
		text-align: center;
		padding: 80px 24px;
		box-sizing: border-box;
	}

	.hero-glow {
		position: absolute;
		width: 520px;
		height: 520px;
		border-radius: 50%;
		background: radial-gradient(
			circle,
			rgba(150, 60, 190, 0.18),
			transparent 68%
		);
		filter: blur(20px);
	}

	.hero-content {
		position: relative;
		max-width: 950px;
		z-index: 1;
	}

	.eyebrow {
		letter-spacing: 0.35em;
		font-size: 0.75rem;
		color: #b78ac7;
		margin-bottom: 24px;
	}

	h1 {
		font-size: clamp(4rem, 12vw, 9rem);
		letter-spacing: 0.08em;
		margin: 0;
		line-height: 0.9;
		font-weight: 400;
		text-shadow: 0 0 35px rgba(170, 80, 210, 0.35);
	}

	.subtitle {
		font-size: clamp(1rem, 2vw, 1.4rem);
		letter-spacing: 0.45em;
		margin: 30px 0;
		color: #d8c4df;
	}

	.intro {
		max-width: 650px;
		margin: 0 auto 40px;
		line-height: 1.8;
		font-size: 1.1rem;
		color: #aaa1ae;
	}

	.hero-actions {
		display: flex;
		gap: 16px;
		justify-content: center;
		flex-wrap: wrap;
	}

	.primary-button,
	.secondary-button {
		display: inline-block;
		padding: 14px 25px;
		text-decoration: none;
		letter-spacing: 0.12em;
		font-size: 0.8rem;
		transition: 0.25s ease;
	}

	.primary-button {
		background: #eee8f2;
		color: #08060b;
	}

	.primary-button:hover {
		transform: translateY(-3px);
		box-shadow: 0 0 30px rgba(210, 150, 230, 0.3);
	}

	.secondary-button {
		border: 1px solid #5f5264;
		color: #eee8f2;
	}

	.secondary-button:hover {
		border-color: #b78ac7;
		color: #d9b9e4;
	}

	.section,
	.lore-section,
	.manifesto {
		max-width: 1200px;
		margin: 0 auto;
		padding: 120px 24px;
	}

	.section-heading {
		text-align: center;
		margin-bottom: 60px;
	}

	h2 {
		font-size: clamp(2rem, 5vw, 4rem);
		font-weight: 400;
		letter-spacing: 0.08em;
		margin: 0;
	}

	.content-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 22px;
	}

	.card {
		padding: 38px;
		border: 1px solid #29212e;
		background: rgba(15, 11, 18, 0.75);
		transition: 0.25s ease;
	}

	.card:hover {
		transform: translateY(-5px);
		border-color: #684575;
	}

	.card-symbol {
		font-size: 2.5rem;
		color: #b78ac7;
	}

	.card h3 {
		font-size: 1.5rem;
		font-weight: 400;
		margin: 20px 0 12px;
	}

	.card p {
		color: #99919d;
		line-height: 1.7;
	}

	.card a {
		display: inline-block;
		margin-top: 15px;
		color: #cda6d9;
		text-decoration: none;
		font-size: 0.8rem;
		letter-spacing: 0.12em;
	}

	.lore-section {
		max-width: none;
		background: rgba(20, 13, 24, 0.65);
		text-align: center;
	}

	.lore-content {
		max-width: 760px;
		margin: auto;
	}

	.lore-content p:not(.eyebrow) {
		color: #aaa1ae;
		line-height: 1.9;
		font-size: 1.05rem;
	}

	.lore-content .primary-button {
		margin-top: 25px;
	}

	.manifesto {
		text-align: center;
		padding-top: 150px;
		padding-bottom: 150px;
	}

	blockquote {
		font-size: clamp(1.8rem, 4vw, 3.5rem);
		line-height: 1.3;
		font-style: italic;
		font-weight: 400;
		max-width: 900px;
		margin: 20px auto;
	}

	.signature {
		color: #b78ac7;
		letter-spacing: 0.25em;
		font-size: 0.8rem;
	}

	@media (max-width: 800px) {
		.content-grid {
			grid-template-columns: 1fr;
		}

		.hero {
			min-height: 80vh;
		}

		.subtitle {
			letter-spacing: 0.2em;
		}
	}
</style>
```

